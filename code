def clean_for_speech(text):
    """Convert AI/markdown/formatted text into natural text suitable for TTS."""
    if text is None:
        return ""

    text = str(text).strip()
    if not text:
        return ""

    # Remove fenced code blocks and inline code markers.
    text = re.sub(r"```(?:[a-zA-Z0-9_+-]+)?\s*", " ", text)
    text = text.replace("```", " ")
    text = re.sub(r"`([^`]*)`", r"\1", text)

    # Turn markdown links into their visible label.
    text = re.sub(r"\[([^\]]+)\]\((?:[^()]|\([^)]*\))*\)", r"\1", text)

    # Remove common LaTeX wrappers and commands while preserving useful text.
    text = text.replace(r"\left", " ").replace(r"\right", " ")
    text = re.sub(r"\\(?:mathrm|text|mathbf|mathit|operatorname)\s*\{([^{}]*)\}", r"\1", text)
    text = re.sub(r"\\frac\s*\{([^{}]*)\}\s*\{([^{}]*)\}", r"\1 divided by \2", text)
    text = re.sub(r"\\sqrt\s*\{([^{}]*)\}", r"the square root of \1", text)
    latex_words = {
        r"\Phi": "phi", r"\phi": "phi",
        r"\Theta": "theta", r"\theta": "theta",
        r"\Delta": "delta", r"\delta": "delta",
        r"\lambda": "lambda", r"\Lambda": "lambda",
        r"\mu": "mu", r"\pi": "pi", r"\Pi": "pi",
        r"\epsilon": "epsilon", r"\varepsilon": "epsilon",
        r"\sigma": "sigma", r"\rho": "rho",
        r"\alpha": "alpha", r"\beta": "beta", r"\gamma": "gamma",
        r"\omega": "omega", r"\Omega": "omega",
        r"\cdot": " times ", r"\times": " times ",
        r"\div": " divided by ", r"\pm": " plus or minus ",
        r"\le": " less than or equal to ", r"\leq": " less than or equal to ",
        r"\ge": " greater than or equal to ", r"\geq": " greater than or equal to ",
        r"\approx": " approximately ", r"\sim": " approximately ",
        r"\infty": " infinity ", r"\degree": " degrees ",
        r"\cos": " cosine ", r"\sin": " sine ", r"\tan": " tangent ",
    }
    for old, new in latex_words.items():
        text = text.replace(old, new)

    # Handle common LaTeX variables and simple subscripts, e.g. \\Phi_B -> phi B.
    text = re.sub(r"\b(phi|theta|delta|lambda|mu|sigma|rho|alpha|beta|gamma|omega|pi)_\{?([A-Za-z0-9]+)\}?", r"\1 \2", text)

    # Plain-text comparison/arithmetic operators.
    text = text.replace(">=", " greater than or equal to ")
    text = text.replace("<=", " less than or equal to ")
    text = re.sub(r"(?<!-)\s*->\s*", " leads to ", text)
    text = re.sub(r"(?<!<)\s*<-\s*", " comes from ", text)

    # Remove remaining escape characters used by markdown / JSON formatting.
    text = text.replace("\\", " ")
    text = text.replace("\\n", " ")
    text = html.unescape(text)

    # Strip markdown emphasis, headings, bullets, quotes, and table separators.
    text = re.sub(r"(?m)^\s{0,3}#{1,6}\s*", "", text)
    text = re.sub(r"(?m)^\s*>\s?", "", text)
    text = re.sub(r"(?m)^\s*[-*+•]\s+", "", text)
    text = re.sub(r"(?m)^\s*\d+\.\s+", "", text)
    text = re.sub(r"\*\*(.*?)\*\*", r"\1", text)
    text = re.sub(r"(?<!\w)\*([^*]+)\*(?!\w)", r"\1", text)
    text = re.sub(r"__([^_]+)__", r"\1", text)
    text = re.sub(r"(?<!\w)_([^_]+)_(?!\w)", r"\1", text)
    text = re.sub(r"(?m)^\s*\|[-:\s|]+\|\s*$", " ", text)
    text = text.replace("|", " ")

    # Remove URLs from speech unless they are clearly part of the answer's meaning.
    text = re.sub(r"https?://\S+", " ", text)
    text = re.sub(r"www\.\S+", " ", text)

    # Make common symbols speak naturally.
    replacements = {
        "Φ": "phi", "φ": "phi",
        "Θ": "theta", "θ": "theta",
        "Δ": "delta", "δ": "delta",
        "λ": "lambda", "Λ": "lambda",
        "μ": "mu", "π": "pi",
        "σ": "sigma", "ρ": "rho",
        "ε": "epsilon",
        "×": " times ", "÷": " divided by ",
        "≥": " greater than or equal to ",
        "≤": " less than or equal to ",
        ">=": " greater than or equal to ",
        "<=": " less than or equal to ",
        "≈": " approximately ",
        "∞": " infinity ",
        "→": " leads to ",
        "←": " comes from ",
        "↔": " is equivalent to ",
        "±": " plus or minus ",
        "∝": " proportional to ",
        "∑": " sum ",
        "∫": " integral ",
        "√": " square root ",
        "°": " degrees ",
        "%": " percent ",
        "—": ", ",
        "–": "-",
        "…": "...",
    }
    for old, new in replacements.items():
        text = text.replace(old, new)

    # Remove residual formatting punctuation that has no spoken value.
    text = re.sub(r"[{}[\]<>~^]", " ", text)
    text = re.sub(r"\s+", " ", text)
    text = re.sub(r"\s+([,.;:!?])", r"\1", text)
    text = re.sub(r"([!?]){2,}", r"\1", text)
    text = re.sub(r"\.{4,}", "...", text)

    return text.strip()

async def generate_speech(text, filename=TTS_FILE):
    """Generate J.A.R.V.I.S. speech using Edge TTS only."""
    communicate = edge_tts.Communicate(
        text,
        EDGE_VOICE,
        rate="-3%",
        pitch="-10Hz",
    )
    await communicate.save(filename)



def stop_current_speech():
    """Stop current J.A.R.V.I.S. speech immediately."""
    speech_stop_event.set()
    try:
        pygame.mixer.music.stop()
    except Exception:
        pass




def set_barge_in_audio(audio):
    global barge_in_audio
    if audio is None:
        return
    with barge_in_lock:
        barge_in_audio = np.asarray(audio, dtype=np.int16).copy()


def take_barge_in_audio():
    global barge_in_audio
    with barge_in_lock:
        audio = barge_in_audio
        barge_in_audio = None
    return audio


def transcribe_audio_buffer(audio, samplerate=16000):
    """Transcribe an interruption captured from the existing PyAudio stream."""
    if audio is None or groq_client is None:
        return ""

    audio = np.asarray(audio, dtype=np.int16)
    if audio.size < int(samplerate * 0.20):
        return ""

    audio_f = audio.astype(np.float32)
    audio_f -= np.mean(audio_f)

    # Do not heavily denoise; preserve a real spoken interruption.
    peak = float(np.max(np.abs(audio_f))) if audio_f.size else 0.0
    if peak < 250.0:
        return ""

    audio_out = np.clip(audio_f, -32768, 32767).astype(np.int16)
    write(QUESTION_WAV, samplerate, audio_out)

    try:
        with open(QUESTION_WAV, "rb") as f:
            transcription = groq_client.audio.transcriptions.create(
                file=(QUESTION_WAV, f.read()),
                model="whisper-large-v3-turbo",
                language="en",
                prompt=STT_PROMPT,
                temperature=0.0,
            )
    except Exception as e:
        print(f"DEBUG: Barge-in transcription failed: {e}")
        return ""

    result = str(transcription.text or "").strip()
    normalized = normalize_command_text(result)

    if not normalized:
        return ""

    ignored = {
        "thank you", "thanks", "bye", "you",
        "thanks for watching", "thank you jarvis",
        "please subscribe", "like and subscribe",
        "subscribe", "like",
    }
    if normalized in ignored:
        return ""

    letters = [ch for ch in result if ch.isalpha()]
    latin = [ch for ch in letters if "a" <= ch.lower() <= "z"]
    if letters and len(latin) / len(letters) < 0.75:
        return ""

    print(f"DEBUG: Barge-in heard: {result}")
    return result




def speak(text, voice_only_trigger=True, allow_barge_in=True):
    """Speak through Edge TTS with a conservative voice-only barge-in detector."""
    with speech_lock:
        display_text = str(text or "").strip()
        speech_text = clean_for_speech(display_text)

        signals.status_changed.emit("speaking")
        signals.text_changed.emit(display_text)

        if not speech_text:
            signals.status_changed.emit("idle")
            return False

        speech_stop_event.clear()
        external_audio_interrupt_event.clear()
        speech_active_event.set()
        interrupted = False

        try:
            try:
                pygame.mixer.music.stop()
                pygame.mixer.music.unload()
            except Exception:
                pass

            last_error = None
            for _ in range(2):
                try:
                    if os.path.exists(TTS_FILE):
                        os.remove(TTS_FILE)
                except OSError:
                    pass

                try:
                    asyncio.run(generate_speech(speech_text, TTS_FILE))
                    if (
                        os.path.isfile(TTS_FILE)
                        and os.path.getsize(TTS_FILE) > 0
                    ):
                        last_error = None
                        break
                    last_error = RuntimeError(
                        "Edge TTS returned no audio file."
                    )
                except Exception as e:
                    last_error = e
                time.sleep(0.12)

            if last_error is not None:
                print(f"DEBUG: Edge TTS failed: {last_error}")
                return False

            pygame.mixer.music.load(TTS_FILE)
            pygame.mixer.music.play()

            # Do not interpret tiny spikes, clicks, keyboard noise, or short
            # background sounds as "STOP". The user must produce a sustained
            # speech-like level clearly above the local microphone baseline.
            baseline_levels = deque(maxlen=20)
            consecutive_voice_frames = 0
            playback_started = time.time()

            ABSOLUTE_VOICE_FLOOR = 430.0
            RELATIVE_VOICE_MULTIPLIER = 1.85
            REQUIRED_CONSECUTIVE_FRAMES = 7  # ~224 ms at 32 ms/frame
            MIN_POST_TRIGGER_COOLDOWN = 0.8

            while pygame.mixer.music.get_busy():
                if laptop_audio_is_playing():
                    external_audio_interrupt_event.set()
                    pygame.mixer.music.stop()
                    interrupted = True
                    print(
                        "DEBUG: External laptop audio detected; "
                        "stopping JARVIS and returning to wake mode."
                    )
                    break

                if speech_stop_event.is_set():
                    pygame.mixer.music.stop()
                    interrupted = True
                    break

                if (
                    allow_barge_in
                    and stream is not None
                    and not shutdown_event.is_set()
                ):
                    try:
                        if (
                            hasattr(stream, "is_active")
                            and not stream.is_active()
                        ):
                            time.sleep(0.02)
                            continue

                        raw = stream.read(
                            320,
                            exception_on_overflow=False,
                        )
                        mic_audio = np.frombuffer(
                            raw,
                            dtype=np.int16,
                        )

                        if mic_audio.size:
                            arr = mic_audio.astype(np.float32)
                            level = float(
                                np.sqrt(np.mean(np.square(arr))) + 1e-9
                            )
                            elapsed = time.time() - playback_started

                            # During the first 0.55 s of playback, only learn
                            # the local acoustic baseline. This prevents the
                            # speaker startup transient from being an interrupt.
                            if elapsed < 0.55:
                                baseline_levels.append(level)
                                time.sleep(0.005)
                                continue

                            if len(baseline_levels) < 10:
                                baseline_levels.append(level)
                                time.sleep(0.005)
                                continue

                            baseline_level = max(
                                85.0,
                                float(np.median(baseline_levels)),
                            )
                            voice_threshold = max(
                                ABSOLUTE_VOICE_FLOOR,
                                baseline_level * RELATIVE_VOICE_MULTIPLIER,
                            )

                            # Only quiet frames update the baseline. A real
                            # spoken phrase therefore cannot raise the threshold
                            # fast enough to hide itself.
                            if level < baseline_level * 1.18:
                                baseline_levels.append(level)

                            if level >= voice_threshold:
                                consecutive_voice_frames += 1
                            else:
                                # A dip resets the candidate strongly.
                                consecutive_voice_frames = 0

                            if (
                                consecutive_voice_frames
                                >= REQUIRED_CONSECUTIVE_FRAMES
                                and elapsed > MIN_POST_TRIGGER_COOLDOWN
                            ):
                                interrupted = True
                                pygame.mixer.music.stop()
                                print(
                                    "DEBUG: Sustained spoken barge-in detected; "
                                    "starting a fresh command listener."
                                )
                                break

                    except Exception:
                        # Barge-in detection must never break normal TTS.
                        pass

                time.sleep(0.005)

            try:
                pygame.mixer.music.stop()
            except Exception:
                pass
            try:
                pygame.mixer.music.unload()
            except Exception:
                pass

            set_barge_in_audio(None)
            return interrupted

        except Exception as e:
            print(f"DEBUG: Speech playback failed: {e}")
            return interrupted

        finally:
            speech_stop_event.clear()
            speech_active_event.clear()
            signals.status_changed.emit("idle")


def laptop_audio_is_playing():
    """Return True only for sustained audible output from another app.

    JARVIS uses pygame in this same Python process.  We therefore identify
    output sessions by their owning Windows process and ignore our own PID.
    Sessions without a real process are ignored as well; those can represent
    Windows/system audio plumbing and were causing false wake resets.
    """
    try:
        sessions = AudioUtilities.GetAllSessions()
    except Exception:
        return False

    current_pid = os.getpid()
    external_peak = False

    for session in sessions:
        try:
            if getattr(session, "State", 0) != 1:
                continue

            process = getattr(session, "Process", None)
            if process is None:
                # Do not classify process-less/system audio plumbing as
                # external media.  This is especially important while JARVIS
                # itself is playing "Yes sir?".
                continue

            try:
                pid = int(process.pid)
            except Exception:
                continue

            # JARVIS's pygame/Edge-TTS playback is owned by this process.
            if pid == current_pid:
                continue

            try:
                meter = session._ctl.QueryInterface(IAudioMeterInformation)
                peak = c_float(0.0)
                meter.GetPeakValue(ctypes.byref(peak))
                if float(peak.value) >= 0.025:
                    external_peak = True
                    break
            except Exception:
                continue

        except Exception:
            continue

    # Require two consecutive positive meter samples.  This prevents a
    # one-sample transition/click from cancelling an active interaction.
    hits = int(globals().get("_external_audio_hits", 0))
    if external_peak:
        hits = min(hits + 1, 3)
    else:
        hits = 0

    globals()["_external_audio_hits"] = hits
    return hits >= 2


def clear_external_audio_detector():
    """Clear the detector's short-lived hysteresis state."""
    globals()["_external_audio_hits"] = 0



def listen_for_question(
    samplerate=16000,
    silence_limit=1.25,
    max_seconds=20,
    timeout=None,
    fast_start=False,
):
    if stream is None or groq_client is None:
        return ""

    signals.status_changed.emit("listening")
    take_barge_in_audio()
    started = time.time()
    calibration_seconds = 0.05 if fast_start else 0.22
    calibration_end = started + calibration_seconds
    noise_levels = []
    recorded = []
    speech_detected = False
    silence_start = None
    above_count = 0
    pre_roll = deque(maxlen=10)

    try:
        if laptop_audio_is_playing():
            external_audio_interrupt_event.set()
            signals.status_changed.emit("idle")
            return ""

        while time.time() < calibration_end and not shutdown_event.is_set():
            if laptop_audio_is_playing():
                external_audio_interrupt_event.set()
                signals.status_changed.emit("idle")
                return ""
            raw = stream.read(640, exception_on_overflow=False)
            audio = np.frombuffer(raw, dtype=np.int16)

            # Check again after each microphone chunk.  If another application
            # starts producing audible output while JARVIS is listening,
            # immediately discard the partial recording and return to wake mode.
            if laptop_audio_is_playing():
                external_audio_interrupt_event.set()
                signals.status_changed.emit("idle")
                return ""
            if audio.size:
                arr = audio.astype(np.float32)
                noise_levels.append(float(np.sqrt(np.mean(np.square(arr))) + 1e-9))

        noise_floor = float(np.median(noise_levels)) if noise_levels else 140.0

        # Require a clear rise above the measured room noise, but don't over-gate.
        speech_threshold = max(110.0 if fast_start else 150.0, noise_floor * (1.12 if fast_start else 1.22))

        while time.time() - started < max_seconds and not shutdown_event.is_set():
            if (
                not speech_detected
                and timeout is not None
                and time.time() - started >= timeout
            ):
                signals.status_changed.emit("idle")
                return ""

            raw = stream.read(640, exception_on_overflow=False)
            audio = np.frombuffer(raw, dtype=np.int16)
            if audio.size == 0:
                continue

            pre_roll.append(audio.copy())
            arr = audio.astype(np.float32)
            level = float(np.sqrt(np.mean(np.square(arr))) + 1e-9)

            if level >= speech_threshold:
                above_count = min(above_count + 1, 8)
            else:
                above_count = max(above_count - 1, 0)

            if not speech_detected and above_count >= (2 if fast_start else 3):
                speech_detected = True
                recorded.extend(list(pre_roll))
                silence_start = None

            if speech_detected:
                recorded.append(audio.copy())

                if level >= speech_threshold:
                    silence_start = None
                elif silence_start is None:
                    silence_start = time.time()
                elif time.time() - silence_start >= silence_limit:
                    break

        if not speech_detected or not recorded:
            signals.status_changed.emit("idle")
            return ""

        if laptop_audio_is_playing():
            signals.status_changed.emit("idle")
            return ""

        signals.status_changed.emit("thinking")

        audio = np.concatenate(recorded).astype(np.float32)
        audio -= np.mean(audio)

        # Preserve the natural waveform. Avoid destructive energy gates
        # or per-frame gain changes that can remove weak consonants.
        audio = audio.astype(np.float32)
        audio -= np.mean(audio)
        audio = np.clip(audio, -32768, 32767).astype(np.int16)

        write(QUESTION_WAV, samplerate, audio)

        with open(QUESTION_WAV, "rb") as f:
            transcription = groq_client.audio.transcriptions.create(
                file=(QUESTION_WAV, f.read()),
                model="whisper-large-v3-turbo",
                language="en",
                prompt=STT_PROMPT,
                temperature=0.0,
            )

        result = str(transcription.text or "").strip()
        normalized = normalize_command_text(result)

        if not result or len(normalized) < 2:
            signals.status_changed.emit("idle")
            return ""

        # Reject common media filler/transcript fragments.
        ignored_exact = {
            "thank you", "thanks", "bye", "you",
            "thanks for watching", "thank you jarvis",
            "please subscribe", "like and subscribe",
            "subscribe", "like",
        }
        if normalized in ignored_exact:
            signals.status_changed.emit("idle")
            return ""

        # Reject transcripts made mostly of a tiny number of common words.
        words = normalized.split()
        if len(words) == 1 and words[0] in {
            "the", "a", "an", "and", "or", "to", "of",
            "is", "are", "it", "this", "that", "yeah", "yes",
        }:
            signals.status_changed.emit("idle")
            return ""

        # Reject non-English-script output.
        letters = [ch for ch in result if ch.isalpha()]
        latin = [ch for ch in letters if "a" <= ch.lower() <= "z"]
        if letters and len(latin) / len(letters) < 0.75:
            print("DEBUG: Ignoring non-English transcript.")
            signals.status_changed.emit("idle")
            return ""

        print(f"DEBUG: Heard: {result}")
        signals.text_changed.emit(result)
        return result

    except Exception as e:
        print(f"DEBUG: Listening/transcription failed: {e}")
        signals.status_changed.emit("idle")
        return ""


def trim_conversation(history):
    if not history:
        return history
    system_message = history[0] if history[0].get("role") == "system" else None
    rest = history[1:] if system_message else history
    rest = rest[-MAX_CONTEXT_MESSAGES:]
    return ([system_message] if system_message else []) + rest


def ask_groq(conversation_history):
    response = groq_client.chat.completions.create(
        model="openai/gpt-oss-120b",
        messages=trim_conversation(conversation_history),
        max_tokens=180,
        reasoning_effort="low",
    )
    return response.choices[0].message.content


def try_parse_command(reply):
    valid_actions = tuple(TOOL_DEFINITIONS.keys())
    try:
        data = json.loads(reply.strip())
        if isinstance(data, dict) and data.get("action") in valid_actions:
            return data.get("action"), data.get("target", "")
    except (json.JSONDecodeError, TypeError):
        pass

    action_pattern = "|".join(re.escape(action) for action in valid_actions)
    match = re.search(
        r'\{[^{}]*"action"\s*:\s*"(' + action_pattern + r')"[^{}]*\}',
        reply,
        re.IGNORECASE,
    )
    if match:
        try:
            data = json.loads(match.group(0))
            return data.get("action"), data.get("target", "")
        except json.JSONDecodeError:
            return None, None
    return None, None




def get_volume_info():
    """Read the current Windows master volume locally."""
    if volume_control is None:
        return "I can't read the Windows volume right now."
    try:
        percent = round(volume_control.GetMasterVolumeLevelScalar() * 100)
        muted = bool(volume_control.GetMute())
        if muted:
            return f"Your volume is at {percent} percent, and the system is muted."
        return f"Your current volume is {percent} percent."
    except Exception as e:
        print(f"DEBUG: Volume read failed: {e}")
        return "I couldn't read the current volume."


def get_active_window_title():
    """Return the title of the currently focused Windows window."""
    if os.name != "nt":
        return None
    try:
        user32 = ctypes.windll.user32
        hwnd = user32.GetForegroundWindow()
        if not hwnd:
            return None
        length = user32.GetWindowTextLengthW(hwnd)
        if length <= 0:
            return None
        buf = ctypes.create_unicode_buffer(length + 1)
        user32.GetWindowTextW(hwnd, buf, length + 1)
        return buf.value.strip() or None
    except Exception:
        return None


def get_computer_status():
    """Compact local snapshot used for computer-awareness questions."""
    parts = []

    try:
        cpu = psutil.cpu_percent(interval=0.15)
        parts.append(f"CPU {cpu:.0f} percent")
    except Exception:
        pass

    try:
        mem = psutil.virtual_memory()
        parts.append(
            f"RAM {mem.percent:.0f} percent used, "
            f"{mem.available / (1024 ** 3):.1f} gigabytes available"
        )
    except Exception:
        pass

    try:
        battery = psutil.sensors_battery()
        if battery:
            parts.append(
                f"battery {battery.percent:.0f} percent"
                + (" and charging" if battery.power_plugged else "")
            )
    except Exception:
        pass

    active = get_active_window_title()
    if active:
        parts.append(f"active window is {active}")

    if volume_control is not None:
        try:
            volume = round(volume_control.GetMasterVolumeLevelScalar() * 100)
            parts.append(f"volume {volume} percent")
        except Exception:
            pass

    return "Your computer currently has " + ", ".join(parts) + "." if parts else \
        "I couldn't read the computer status right now."


def get_running_app_summary():
    """Give a lightweight list of notable running applications."""
    wanted = {
        "brave.exe": "Brave",
        "msedge.exe": "Microsoft Edge",
        "Code.exe": "VS Code",
        "notepad.exe": "Notepad",
        "WINWORD.EXE": "Word",
        "EXCEL.EXE": "Excel",
        "explorer.exe": "File Explorer",
    }
    running = set()
    try:
        for proc in psutil.process_iter(["name"]):
            name = (proc.info.get("name") or "").lower()
            if name in wanted:
                running.add(wanted[name])
    except Exception as e:
        print(f"DEBUG: Process awareness failed: {e}")

    if not running:
        return "I don't see any of the main applications I track running."
    return "Currently running: " + ", ".join(sorted(running)) + "."



def get_wifi_info():
    """Return a lightweight local Wi-Fi connection status on Windows."""
    if os.name != "nt":
        return "Wi-Fi status is only available on Windows."
    try:
        result = subprocess.run(
            ["netsh", "wlan", "show", "interfaces"],
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="ignore",
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
            timeout=3,
        )
        output = result.stdout

        state_match = re.search(r"^\s*State\s*:\s*(.+)$", output, re.MULTILINE | re.IGNORECASE)
        ssid_match = re.search(r"^\s*SSID\s*:\s*(.+)$", output, re.MULTILINE | re.IGNORECASE)

        if state_match and state_match.group(1).strip().lower() == "connected":
            ssid = ssid_match.group(1).strip() if ssid_match else "an unknown network"
            return f"Wi-Fi is connected to {ssid}."
        return "Wi-Fi is not currently connected."
    except Exception as e:
        print(f"DEBUG: Wi-Fi status failed: {e}")
        return "I couldn't read the Wi-Fi status."


def get_laptop_name():
    try:
        return f"Your computer name is {os.environ.get('COMPUTERNAME') or os.uname().nodename}."
    except Exception:

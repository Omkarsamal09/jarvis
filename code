def get_system_uptime():
    try:
        boot_time = datetime.fromtimestamp(psutil.boot_time())
        delta = datetime.now() - boot_time
        total_minutes = max(0, int(delta.total_seconds() // 60))
        hours, minutes = divmod(total_minutes, 60)
        return f"Windows has been running for {hours} hours and {minutes} minutes."
    except Exception:
        return "I couldn't read the system uptime."


def normalize_command_text(q):
    q = re.sub(r"\s+", " ", q.lower().strip())
    return q.strip(" .!?,")



def calculate_simple_math(question):
    """Evaluate only simple arithmetic expressions with no executable code."""
    q = normalize_command_text(question)
    q = re.sub(
        r"^(?:what is|what's|calculate|compute|how much is)\\s+",
        "",
        q,
    )
    q = q.replace("multiplied by", "*")
    q = q.replace("multiply", "*")
    q = q.replace("times", "*")
    q = q.replace("divided by", "/")
    q = q.replace("divide", "/")
    q = q.replace("plus", "+")
    q = q.replace("minus", "-")
    q = q.replace("to the power of", "**")
    q = q.replace("power", "**")
    q = q.replace("x", "*")
    q = q.replace("÷", "/")
    q = q.replace("×", "*")

    # Only permit numbers, spaces, decimal points, parentheses and operators.
    if not re.fullmatch(r"[0-9+*/().%\\-\\s]+", q):
        return None

    # Avoid division by zero and absurdly long expressions.
    if len(q) > 60:
        return None

    try:
        import ast as _ast
        node = _ast.parse(q, mode="eval")

        allowed = (
            _ast.Expression, _ast.BinOp, _ast.UnaryOp, _ast.Add,
            _ast.Sub, _ast.Mult, _ast.Div, _ast.Pow, _ast.Mod,
            _ast.USub, _ast.UAdd, _ast.Constant, _ast.Load,
            _ast.FloorDiv,
        )
        for part in _ast.walk(node):
            if not isinstance(part, allowed):
                return None
            if isinstance(part, _ast.Constant) and (
                not isinstance(part.value, (int, float))
                or isinstance(part.value, bool)
            ):
                return None

        value = eval(compile(node, "<math>", "eval"), {"__builtins__": {}}, {})
        if isinstance(value, complex) or not np.isfinite(float(value)):
            return None

        if abs(value - round(value)) < 1e-10:
            return str(int(round(value)))
        return f"{value:.10g}"
    except Exception:
        return None



def local_intent_router(question):
    """Execute only high-confidence local actions/facts."""
    q = normalize_command_text(question)

    math_answer = calculate_simple_math(q)
    if math_answer is not None:
        return True, math_answer

    local_answer = check_local_answer(q)
    if local_answer is not None:
        return True, local_answer

    if re.fullmatch(
        r"(?:what(?:'s| is)|tell me|show me)\s+"
        r"(?:my\s+)?(?:current\s+)?(?:volume|sound)"
        r"(?:\s+(?:level|percent|percentage|status))?",
        q,
    ):
        return True, get_volume_info()

    if re.fullmatch(
        r"(?:what(?:'s| is)|show me|tell me)\s+"
        r"(?:my\s+)?computer\s+status",
        q,
    ):
        return True, get_computer_status()

    if re.fullmatch(
        r"(?:what|which)\s+(?:is\s+)?(?:my\s+)?(?:active|focused)\s+"
        r"(?:window|app)",
        q,
    ):
        active = get_active_window_title()
        return True, (
            f"The active window is {active}."
            if active else
            "I couldn't identify the active window."
        )

    if re.fullmatch(
        r"(?:what|which)\s+(?:apps?|applications?)\s+"
        r"(?:are\s+)?(?:running|open)",
        q,
    ):
        return True, get_running_app_summary()

    system_patterns = (
        (r"^(?:please\s+)?(?:shut\s+down|shutdown)\s+"
         r"(?:my\s+)?(?:laptop|computer|pc)$", "shutdown"),
        (r"^(?:please\s+)?(?:turn\s+off|power\s+off)\s+"
         r"(?:my\s+)?(?:laptop|computer|pc)$", "shutdown"),
        (r"^(?:please\s+)?(?:restart|reboot)\s+"
         r"(?:my\s+)?(?:laptop|computer|pc)$", "restart"),
        (r"^(?:please\s+)?lock\s+(?:my\s+)?"
         r"(?:laptop|computer|pc|screen)$", "lock"),
        (r"^(?:please\s+)?(?:sleep|suspend)\s+"
         r"(?:my\s+)?(?:laptop|computer|pc)$", "sleep"),
    )
    for pattern, action in system_patterns:
        if re.fullmatch(pattern, q):
            return True, system_control(action)

    m = re.fullmatch(
        r"(?:please\s+)?(?:open|launch|start|go to)\s+(.+)",
        q,
    )
    if m:
        target = re.sub(
            r"\b(?:website|site|page)\b$", "", m.group(1)
        ).strip()
        aliases = {
            "you tube": "youtube",
            "insta": "instagram",
            "vs code": "vscode",
            "visual studio code": "vscode",
            "microsoft edge": "edge",
            "edge browser": "edge",
        }
        target = aliases.get(target, target)
        if target in KNOWN_SITES:
            return True, open_site(target)
        if target in APP_MAP:
            return True, open_app(target)

        if re.fullmatch(
            r"(?:https?://)?[a-z0-9-]+\.[a-z]{2,}"
            r"(?:/[\w./?%&=+#:-]*)?",
            target,
        ):
            return True, open_site(target)

    m = re.fullmatch(
        r"(?:please\s+)?(?:search|find|look up)\s+"
        r"(?:for\s+)?(.+?)\s+(?:on|in)\s+"
        r"(youtube|google|amazon|instagram|reddit|twitter|x)",
        q,
    )
    if m:
        return True, site_search(f"{m.group(2)}|{m.group(1).strip()}")

    return False, None



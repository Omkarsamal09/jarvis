def is_windows_desktop_foreground():
    """Return True when Windows is actually showing the desktop shell."""
    if os.name != "nt":
        return False
    try:
        user32 = ctypes.windll.user32
        hwnd = user32.GetForegroundWindow()
        if not hwnd:
            return False

        # Never classify the HUD itself as an app.
        if orb_instance is not None:
            try:
                if hwnd == int(orb_instance.winId()):
                    return not bool(orb_instance._compact)
            except Exception:
                pass

        def get_class(win):
            buf = ctypes.create_unicode_buffer(256)
            user32.GetClassNameW(win, buf, 255)
            return buf.value.strip()

        def is_shell_view(win):
            if not win:
                return False
            cls = get_class(win)
            if cls in {"Progman", "WorkerW", "SHELLDLL_DefView", "ShellView"}:
                return True
            parent = user32.GetParent(win)
            if parent and get_class(parent) in {"Progman", "WorkerW", "SHELLDLL_DefView"}:
                return True
            root = user32.GetAncestor(win, 2)  # GA_ROOT
            if root and get_class(root) in {"Progman", "WorkerW", "SHELLDLL_DefView"}:
                return True
            return False

        if is_shell_view(hwnd):
            return True

        # If the shell's desktop-view window exists and is the foreground/root
        # window, treat it as desktop even on Windows builds that use WorkerW.
        progman = user32.FindWindowW("Progman", None)
        if progman:
            shell_view = user32.FindWindowExW(progman, 0, "SHELLDLL_DefView", None)
            if shell_view and (hwnd == shell_view or user32.GetAncestor(hwnd, 2) == shell_view):
                return True

        # Some Windows 10/11 configurations put the desktop icons on WorkerW.
        worker = 0
        while True:
            worker = user32.FindWindowExW(0, worker, "WorkerW", None)
            if not worker:
                break
            shell_view = user32.FindWindowExW(worker, 0, "SHELLDLL_DefView", None)
            if shell_view and (hwnd == worker or hwnd == shell_view or user32.GetAncestor(hwnd, 2) == worker):
                return True

        return False
    except Exception:
        return False


class JarvisOrb(QWidget):
    """Desktop holographic HUD + compact classic orb when another app is active."""
    EXPANDED_W = 1160
    EXPANDED_H = 820
    COMPACT = 104
    def __init__(self):
        super().__init__()
        self.status = "idle"
        self._phase = 0.0
        self._scanner = 0.0
        self._pulse = 0.0
        self._dragging = False
        self._drag_offset = QPoint()
        self._press_pos = QPoint()
        self._compact = False
        self._last_text = "J.A.R.V.I.S. ONLINE"
        self._last_transition = time.time()
        self._mode_anim = QPropertyAnimation(self, b'geometry')
        self._mode_anim.setDuration(450)
        self._mode_anim.setEasingCurve(QEasingCurve.OutCubic)

        self.setWindowFlags(Qt.FramelessWindowHint | Qt.Tool | Qt.WindowStaysOnTopHint)
        self.setAttribute(Qt.WA_TranslucentBackground, True)
        self.setAttribute(Qt.WA_ShowWithoutActivating, True)
        self.setAttribute(Qt.WA_NoSystemBackground, True)
        self.setMouseTracking(True)

        self.response_box = QPlainTextEdit(self)
        self.response_box.setReadOnly(True)
        self.response_box.setFrameStyle(0)
        self.response_box.setLineWrapMode(QPlainTextEdit.WidgetWidth)
        self.response_box.setVerticalScrollBarPolicy(Qt.ScrollBarAlwaysOn)
        self.response_box.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self.response_box.setStyleSheet(
            "QPlainTextEdit { background: rgba(4,14,26,120); border: 1px solid rgba(115,195,255,145); "
            "border-radius: 12px; color: rgba(230,245,255,235); padding: 10px; "
            "font-family: 'Segoe UI'; font-size: 10pt; }"
            "QScrollBar:vertical { background: rgba(20,40,60,95); width: 10px; margin: 5px 3px; border-radius: 5px; }"
            "QScrollBar::handle:vertical { background: rgba(135,200,250,180); border-radius: 5px; min-height: 28px; }"
            "QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }"
        )
        self.response_box.hide()

        self.stop_button = QPushButton("■  STOP", self)
        self.stop_button.clicked.connect(stop_current_speech)
        self.stop_button.setCursor(Qt.PointingHandCursor)
        self.stop_button.setStyleSheet(
            "QPushButton { background: rgba(18,28,45,205); color: #F2F7FF; "
            "border: 1px solid rgba(160,205,255,130); border-radius: 8px; "
            "padding: 5px 12px; font: 600 9pt 'Segoe UI'; }"
            "QPushButton:hover { background: rgba(35,52,78,230); }"
        )
        self.stop_button.hide()

        self._screen_center = QPoint(0, 0)
        self._place_initial()

        rng = np.random.default_rng(42)
        self._particles = []
        for _ in range(260):
            self._particles.append({
                "a": float(rng.uniform(0, 2*np.pi)),
                "r": float(rng.uniform(155, 380)),
                "s": float(rng.uniform(-0.010, 0.010)),
                "size": float(rng.uniform(0.7, 2.1)),
                "alpha": int(rng.uniform(35, 180)),
            })

        self._timer = QTimer(self)
        self._timer.timeout.connect(self._animate)
        self._timer.start(30)

        self._window_timer = QTimer(self)
        self._window_timer.timeout.connect(self._sync_mode)
        self._window_timer.start(60)


    def _place_initial(self):
        screen = QApplication.primaryScreen()
        if screen is None:
            return

        area = screen.availableGeometry()

        if self._compact:
            size = self.COMPACT
            self.setGeometry(
                area.right() - size - 28,
                area.top() + (area.height() - size) // 2,
                size,
                size,
            )
        else:
            self.setGeometry(
                area.left() + (area.width() - self.EXPANDED_W) // 2,
                area.top() + (area.height() - self.EXPANDED_H) // 2,
                self.EXPANDED_W,
                self.EXPANDED_H,
            )


    def _set_expanded(self, compact=False, force=False):
        compact = bool(compact)

        if not force and compact == self._compact:
            return

        previous_compact = self._compact
        self._compact = compact

        screen = QApplication.primaryScreen()
        if screen is not None:
            area = screen.availableGeometry()

            if compact:
                size = self.COMPACT
                target = QRect(
                    area.right() - size - 28,
                    area.top() + (area.height() - size) // 2,
                    size,
                    size,
                )
            else:
                target = QRect(
                    area.left() + (area.width() - self.EXPANDED_W) // 2,
                    area.top() + (area.height() - self.EXPANDED_H) // 2,
                    self.EXPANDED_W,
                    self.EXPANDED_H,
                )
        else:
            if compact:
                target = QRect(
                    self.x(), self.y(), self.COMPACT, self.COMPACT
                )
            else:
                target = QRect(
                    self.x(), self.y(),
                    self.EXPANDED_W, self.EXPANDED_H
                )

        if compact:
            self.response_box.hide()
            self.stop_button.hide()
        elif previous_compact:
            # Keep children hidden during the growth animation.
            self.response_box.hide()
            self.stop_button.hide()

        anim = getattr(self, "_mode_anim", None)
        if anim is None:
            self.setGeometry(target)
            if not compact:
                self._layout_children()
                self.response_box.show()
        else:
            anim.stop()
            anim.setStartValue(self.geometry())
            anim.setEndValue(target)

            # Reconnect the finish callback cleanly for repeated transitions.
            try:
                anim.finished.disconnect()
            except TypeError:
                pass

            def finish_mode():
                if self._compact:
                    self.response_box.hide()
                    self.stop_button.hide()
                else:
                    self._layout_children()
                    self.response_box.show()

            anim.finished.connect(finish_mode)
            anim.start()

        self.update()


    def _layout_children(self):
        if self._compact:
            self.response_box.hide()
            self.stop_button.hide()
            return

        self.response_box.setGeometry(575, 520, 520, 170)
        self.stop_button.setGeometry(960, 705, 100, 32)
        self.stop_button.setVisible(self.status == "speaking")


    def _sync_mode(self):
        try:
            desktop = is_windows_desktop_foreground()
        except Exception:
            desktop = not self._compact

        desired_compact = not desktop
        if desired_compact != self._compact:
            self._set_expanded(desired_compact)

    def set_status(self, status):
        if status not in STATUS_COLORS:
            status = "idle"
        self.status = status
        if status == "idle" and self._last_text.startswith("J.A.R.V.I.S."):
            pass
        self.stop_button.setVisible((not self._compact) and status == "speaking")
        self._last_transition = time.time()
        self.update()

    def set_text(self, text):
        text = re.sub(r"\s+", " ", str(text or "")).strip()
        self._last_text = text[:5000] if text else "J.A.R.V.I.S. ONLINE"
        if not self._compact:
            # Every new assistant answer starts at the top. The user can then
            # scroll downward naturally without the view being repositioned.
            self.response_box.setPlainText(self._last_text)
            scrollbar = self.response_box.verticalScrollBar()
            scrollbar.setValue(scrollbar.minimum())
        self.update()

    def mousePressEvent(self, event):
        if event.button() in (Qt.LeftButton, Qt.RightButton):
            self._press_pos = event.globalPos()
            self._drag_offset = event.globalPos() - self.frameGeometry().topLeft()
            self._dragging = False
            event.accept()
            return
        super().mousePressEvent(event)

    def mouseMoveEvent(self, event):
        if (event.buttons() & Qt.LeftButton) and self._drag_offset is not None:
            if (event.globalPos() - self._press_pos).manhattanLength() >= 5:
                self._dragging = True
            if self._dragging:
                self.move(event.globalPos() - self._drag_offset)
                self._screen_center = self.geometry().center()
            event.accept()
            return
        super().mouseMoveEvent(event)

    def mouseReleaseEvent(self, event):
        if event.button() == Qt.RightButton:
            self._drag_offset = None
            self.show_context_menu(event.globalPos())
            event.accept()
            return
        if event.button() == Qt.LeftButton:
            was_dragging = self._dragging
            self._dragging = False
            self._drag_offset = None
            if not was_dragging:
                self.show_context_menu(event.globalPos())
            event.accept()
            return
        super().mouseReleaseEvent(event)


    def show_context_menu(self, pos):
        menu = QMenu(self)
        menu.setStyleSheet(
            "QMenu { background: #101927; color: #EAF4FF; border: 1px solid #36506E; padding: 6px; }"
            "QMenu::item { padding: 8px 24px; }"
            "QMenu::item:selected { background: #263B59; }"
        )

        mode = menu.addAction(
            "Expand J.A.R.V.I.S." if self._compact else "Minimize to Orb"
        )
        reset = menu.addAction("Reset to Wake Mode")
        close = menu.addAction("Close JARVIS")

        selected = menu.exec_(pos)
        if selected == mode:
            self._set_expanded(not self._compact, force=True)
        elif selected == reset:
            reset_to_wake_mode()
        elif selected == close:
            request_shutdown()

    def _color(self):
        c = STATUS_COLORS.get(self.status, STATUS_COLORS["idle"])
        return QColor(c)

    def _pen(self, alpha=180, width=1):
        c = self._color(); c.setAlpha(alpha)
        return QPen(c, width)

    def _draw_glow(self, p, cx, cy, r, alpha):
        c = self._color(); c.setAlpha(alpha)
        p.setPen(Qt.NoPen); p.setBrush(QBrush(c))
        p.drawEllipse(QPoint(int(cx), int(cy)), int(r), int(r))

    def _arc(self, p, cx, cy, r, start, span, width, alpha):
        p.setBrush(Qt.NoBrush); p.setPen(self._pen(alpha, width))
        p.drawArc(QRectF(cx-r, cy-r, 2*r, 2*r), int(start*16), int(span*16))

    def _draw_particles(self, p, cx, cy):
        c = self._color(); p.setPen(Qt.NoPen)
        for pt in self._particles:
            a = pt["a"]; r = pt["r"]
            x = cx + np.cos(a) * r
            y = cy + np.sin(a) * r * 0.58
            alpha = int(pt["alpha"] * (0.55 + 0.45*self._pulse))
            cc = QColor(c.red(), c.green(), c.blue(), max(8, alpha))
            p.setBrush(cc)
            rr = max(1, int(pt["size"]))
            p.drawEllipse(QPoint(int(x), int(y)), rr, rr)

    def _draw_core(self, p, cx, cy, R):
        c = self._color()
        for mul, a in ((0.78,7),(0.64,10),(0.52,15),(0.40,22),(0.28,32)):
            self._draw_glow(p, cx, cy, R*mul, a)

        p.setBrush(Qt.NoBrush)
        # Outer segmented mechanical ring.
        for i in range(36):
            a = 2*np.pi*i/36 + self._phase*0.10
            r0 = R*0.67; r1 = R*(0.72 if i%3 else 0.78)
            x0 = cx + np.cos(a)*r0; y0 = cy + np.sin(a)*r0
            x1 = cx + np.cos(a)*r1; y1 = cy + np.sin(a)*r1
            p.setPen(self._pen(115 + (i%3)*25, 1 if i%4 else 2))
            p.drawLine(int(x0), int(y0), int(x1), int(y1))

        # Inner iris blades.
        for i in range(16):
            a = 2*np.pi*i/16 - self._phase*(0.22 if i%2 else -0.12)
            x0 = cx + np.cos(a)*R*0.28; y0 = cy + np.sin(a)*R*0.28
            x1 = cx + np.cos(a+0.30)*R*0.48; y1 = cy + np.sin(a+0.30)*R*0.48
            p.setPen(self._pen(180, 2 if i%4==0 else 1))
            p.drawLine(int(x0),int(y0),int(x1),int(y1))

        core_r = int(R*(0.20 + 0.018*np.sin(self._phase*3) + 0.018*self._pulse))
        p.setPen(Qt.NoPen); p.setBrush(QBrush(QColor(c.red(),c.green(),c.blue(),235)))
        p.drawEllipse(QPoint(int(cx),int(cy)), core_r, core_r)
        p.setBrush(QBrush(QColor(235,250,255,240)))
        p.drawEllipse(QPoint(int(cx-core_r*0.26), int(cy-core_r*0.28)), max(3,core_r//7), max(3,core_r//7))

    def _draw_technical_frame(self, p):
        c = self._color(); c.setAlpha(145)
        p.setPen(QPen(c,1)); p.setBrush(Qt.NoBrush)
        # Four corner brackets + horizontal datum lines.
        x0, y0, x1, y1 = 32, 32, self.width()-32, self.height()-32
        L = 46
        for x,y,sx,sy in ((x0,y0,1,1),(x1,y0,-1,1),(x0,y1,1,-1),(x1,y1,-1,-1)):
            p.drawLine(x,y,x+sx*L,y); p.drawLine(x,y,x,y+sy*L)
        p.drawLine(70, 88, 330, 88)
        p.drawLine(650, 88, 890, 88)
        p.drawLine(70, 438, 470, 438)
        p.drawLine(490, 438, 890, 438)

    def _draw_side_panels(self, p, cx, cy):
        c = self._color()
        p.setFont(QFont("Consolas", 9))
        p.setPen(QColor(210,235,248,205))
        left_lines = [
            "NEURAL LINK      ONLINE",
            "WAKE MODEL       READY",
            "ENGLISH STT      READY",
            "ACTION FIREWALL  ARMED",
            "AUDIO GUARD      ACTIVE",
        ]
        right_lines = [
            "SYSTEM",
            "CPU",
            "RAM",
            "BATTERY",
            "NETWORK",
        ]
        for i,t in enumerate(left_lines):
            p.drawText(72, 122+i*20, t)
        for i,t in enumerate(right_lines):
            p.setPen(QColor(c.red(),c.green(),c.blue(),185))
            p.drawText(720, 122+i*20, t)
            p.setPen(QColor(195,225,242,175))
        # tiny meter bars
        for row in range(5):
            yy=132+row*20
            val=0.45+0.25*np.sin(self._phase*1.7+row)
            for k in range(18):
                active = k < int(18*val)
                cc = QColor(c.red(),c.green(),c.blue(),135 if active else 26)
                p.setPen(Qt.NoPen); p.setBrush(cc)
                p.drawRect(805+k*4, yy-7, 3, 8)

    def _draw_title(self, p):
        c = self._color()
        p.setPen(QColor(235,250,255,240)); p.setFont(QFont("Segoe UI", 28, QFont.Bold))
        p.drawText(72, 70, "J.A.R.V.I.S.")
        p.setPen(QColor(c.red(),c.green(),c.blue(),220)); p.setFont(QFont("Consolas", 10, QFont.Bold))
        p.drawText(300, 69, STATUS_TEXT.get(self.status, "READY").upper())

        p.setPen(QColor(160,200,225,140)); p.setFont(QFont("Consolas", 8))
        p.drawText(72, 100, "PERSONAL DESKTOP INTELLIGENCE // VOICE CONTROL")

    def _draw_response_header(self, p):
        c=self._color()
        p.setPen(QColor(c.red(),c.green(),c.blue(),210)); p.setFont(QFont("Consolas", 9, QFont.Bold))
        p.drawText(585, 445, "RESPONSE STREAM")
        p.setPen(QColor(170,205,225,130)); p.setFont(QFont("Consolas", 7))
        p.drawText(585, 458, "LIVE OUTPUT // ENGLISH")

    def paintEvent(self, event):
        p = QPainter(self); p.setRenderHint(QPainter.Antialiasing, True)
        c = self._color(); pulse=(np.sin(self._phase)+1)/2
        if self._compact:
            center=QPoint(self.width()//2,self.height()//2)
            for rr,aa in ((31,12),(26,24),(22,46)):
                self._draw_glow(p,center.x(),center.y(),rr+(2 if self.status!="idle" else 0),aa)
            p.setBrush(Qt.NoBrush)
            p.setPen(QPen(QColor(c.red(),c.green(),c.blue(),210),3))
            p.drawEllipse(center,26,26)
            p.setPen(QPen(QColor(c.red(),c.green(),c.blue(),180),1))
            p.drawArc(center.x()-33,center.y()-33,66,66,
                      int(-self._phase*40*16),130*16)
            p.setBrush(QBrush(c)); p.setPen(Qt.NoPen)
            p.drawEllipse(center,19,19)
            p.setBrush(QBrush(QColor(245,252,255,225)))
            p.drawEllipse(QPoint(center.x()-6,center.y()-7),5,5)
            p.end(); return

        self._draw_technical_frame(p)
        cx,cy=560,315
        self._draw_particles(p,cx,cy)
        self._arc(p,cx,cy,360,self._phase*28,125,2,115)
        self._arc(p,cx,cy,336,-self._phase*48+50,88,1,100)
        self._arc(p,cx,cy,312,self._phase*67+180,175,1,100)
        self._arc(p,cx,cy,276,-self._phase*95,260,2,155)
        self._arc(p,cx,cy,235,self._phase*120+40,105,2,180)
        self._draw_core(p,cx,cy,182)
        # Scanner sweep.
        p.setPen(QPen(QColor(c.red(),c.green(),c.blue(),75),1))
        ang=self._scanner; x=cx+np.cos(ang)*378; y=cy+np.sin(ang)*220
        p.drawLine(int(cx),int(cy),int(x),int(y))
        self._draw_title(p)
        self._draw_side_panels(p,cx,cy)
        self._draw_response_header(p)

        p.setPen(QColor(160,205,230,120)); p.setFont(QFont("Consolas",8))
        p.drawText(78, 775, "DRAG TO MOVE  •  CLICK / RIGHT-CLICK FOR MENU  •  F12")
        p.setPen(QColor(c.red(),c.green(),c.blue(),190)); p.drawText(900,775,"HOLOGRAPHIC HUD")
        p.end()

    def _animate(self):
        target=1.0 if self.status!="idle" else 0.25
        self._pulse += (target-self._pulse)*0.10
        self._phase += 0.035
        self._scanner += 0.045
        for pt in self._particles:
            pt["a"] += pt["s"]*(1.0+self._pulse*2)
        self.update()


class JarvisKeyFilter(QObject):
    """Global keyboard safety control for JARVIS during development."""

    def eventFilter(self, obj, event):
        # F12 is the hidden emergency exit while we test the assistant.
        if event.type() == QEvent.KeyPress and event.key() == Qt.Key_F12:
            try:
                request_shutdown()
            except Exception as e:
                print(f"WARNING: shutdown cleanup failed: {e}")
            try:
                if app_instance is not None:
                    app_instance.quit()
            except Exception:
                pass
            event.accept()
            return True

        return super().eventFilter(obj, event)


def main():
    global app_instance, orb_instance

    app = QApplication(sys.argv)
    app_instance = app

    key_filter = JarvisKeyFilter()
    app.installEventFilter(key_filter)

    orb = JarvisOrb()
    orb_instance = orb
    signals.status_changed.connect(orb.set_status)
    signals.text_changed.connect(orb.set_text)
    signals.shutdown_requested.connect(request_shutdown)

    # Start with the full desktop HUD; it automatically collapses over apps.
    orb.show()
    orb.raise_()

    def startup_services():
        try:
            services_ready = initialize_jarvis_services()

            try:
                reminder_thread = threading.Thread(
                    target=reminder_checker_loop,
                    daemon=True
                )
                reminder_thread.start()
            except Exception as e:
                print(f"WARNING: Reminder service unavailable: {e}")

            try:
                battery_monitor_thread = threading.Thread(
                    target=battery_monitor_loop,
                    daemon=True
                )
                battery_monitor_thread.start()
            except Exception as e:
                print(f"WARNING: Battery monitor unavailable: {e}")

            try:
                system_health_monitor_thread = threading.Thread(
                    target=system_health_monitor_loop,
                    daemon=True
                )
                system_health_monitor_thread.start()
            except Exception as e:
                print(f"WARNING: System health monitor unavailable: {e}")

            if services_ready:
                signals.text_changed.emit("VOICE LINK ONLINE  •  READY FOR COMMANDS")
                try:
                    voice_thread = threading.Thread(
                        target=jarvis_voice_loop,
                        daemon=True
                    )
                    voice_thread.start()
                except Exception as e:
                    print(f"WARNING: Voice service unavailable: {e}")
            else:
                signals.text_changed.emit("VOICE LINK ERROR  •  CHECK TERMINAL")
                print(
                    "WARNING: Voice service was not started because "
                    "audio initialization failed."
                )

        except Exception as e:
            print(f"JARVIS startup error: {e}")

    threading.Thread(
        target=startup_services,
        daemon=True
    ).start()

    sys.exit(app.exec_())

if __name__ == "__main__":
    main()  


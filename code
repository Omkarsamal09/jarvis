def resolve_followup_reference(question):
    """
    Phase 36: resolve simple natural follow-ups such as:
      "search for it on YouTube"
      "open that"
      "search for the same thing"
    Only resolves a reference when the previous target is unambiguous.
    """
    q = normalize_command_text(question)
    state = get_conversation_state()

    if (
        not state.get("last_action")
        or time.time() - state.get("last_action_time", 0.0) > 300
    ):
        return question

    target = state.get("last_action")
    if not target:
        return question

    # Resolve references only in obvious follow-up commands. Do not rewrite
    # ordinary sentences such as "Is it raining?"
    followup_patterns = (
        r"^(?:please\s+)?(?:open|launch|start)\s+(?:it|that|this|the same|the same thing|that one)$",
        r"^(?:please\s+)?(?:search|find)\s+(?:for\s+)?(?:it|that|this|the same|the same thing|that one)(?:\s+(?:on|in|for)\s+.+)?$",
        r"^(?:please\s+)?(?:do|do exactly)\s+(?:the same|that)$",
    )
    if not any(re.fullmatch(pattern, q) for pattern in followup_patterns):
        return question

    return re.sub(
        r"\b(?:the same thing|same thing|that one|it|that|this)\b",
        target,
        q,
        count=1,
    )



INTENT_CONFIDENCE_THRESHOLD = 0.78
INTENT_MARGIN_THRESHOLD = 0.15


def classify_intent(question):
    """
    Score the most likely JARVIS intent.

    Returns:
        {
            "intent": str,
            "confidence": float,
            "runner_up": str,
            "runner_up_confidence": float,
            "ambiguous": bool,
        }

    Confidence is deterministic and based on:
      - explicit command phrases
      - entity matches (known app/site)
      - action verbs
      - local-fact vocabulary
      - current-information vocabulary
      - ambiguity penalties
    """
    q = normalize_command_text(question)

    scores = {
        "local_fact": 0.0,
        "local_action": 0.0,
        "website_action": 0.0,
        "site_search": 0.0,
        "web_research": 0.0,
        "conversation": 0.0,
        "general_question": 0.0,
        "ambiguous": 0.0,
    }

    words = set(q.split())

    # --- Exact/local fact signals ---------------------------------------
    if re.search(
        r"\b(?:current|my|what(?:'s| is)|tell me|show me)\b.*"
        r"\b(?:volume|sound|ram|memory usage|memory used|cpu|processor|battery|charge|"
        r"storage|disk|wifi|wi-fi|wireless|uptime|computer name|pc name|"
        r"laptop name|time|date)\b",
        q,
    ):
        scores["local_fact"] += 0.74

    if re.search(r"\b(?:what|how much|how many|tell me|show me)\b", q):
        scores["general_question"] += 0.28

    # --- Local action signals -------------------------------------------
    action_verbs = r"\b(?:open|launch|start|close|quit|show|hide|lock|sleep|"
    action_verbs += r"restart|shutdown|mute|unmute|set|increase|decrease)\b"
    if re.search(action_verbs, q):
        scores["local_action"] += 0.55

    if re.search(r"\b(?:set|make|turn)\s+(?:the )?volume\b", q):
        scores["local_action"] += 0.30

    # --- Known entities improve confidence -------------------------------
    known_app = any(
        re.search(rf"\b{re.escape(name)}\b", q)
        for name in APP_MAP
    )
    known_site = any(
        re.search(rf"\b{re.escape(name)}\b", q)
        for name in KNOWN_SITES
    )

    if known_app:
        scores["local_action"] += 0.28
    if known_site:
        scores["website_action"] += 0.38

    if re.match(
        r"^(?:please\s+)?(?:open|launch|start|go to)\b",
        q,
    ):
        if known_site:
            scores["website_action"] += 0.48
        elif known_app:
            scores["local_action"] += 0.48
        else:
            scores["ambiguous"] += 0.30

    # --- Site-search signals --------------------------------------------
    if re.search(
        r"\b(?:search|find|look up)\b.*\b(?:on|in|for)\b",
        q,
    ):
        scores["site_search"] += 0.46

    site_search_names = (
        "instagram", "youtube", "google", "amazon",
        "reddit", "twitter", "x",
    )
    if any(
        re.search(rf"\b{re.escape(site)}\b", q)
        for site in site_search_names
    ):
        scores["site_search"] += 0.32

    # --- Web research signals -------------------------------------------
    if re.search(
        r"\b(?:latest|newest|recent|recently|news|breaking|price|stock|"
        r"weather|forecast|live|announcement|announced|update|updates|"
        r"who won|what happened)\b",
        q,
    ):
        scores["web_research"] += 1.05

    if re.search(
        r"\b(?:today|this week|this month|yesterday|right now)\b",
        q,
    ):
        scores["web_research"] += 0.22

    # Deterministic local facts should beat "current/today" web signals.
    if re.search(
        r"\b(?:current|today'?s?)\s+(?:date|time)\b|"
        r"\bwhat(?:'s| is)\s+(?:the )?(?:date|time)\b",
        q,
    ):
        scores["local_fact"] = max(scores["local_fact"], 1.0)
        scores["web_research"] = 0.0

    # --- Follow-up commands ---------------------------------------------
    if re.fullmatch(
        r"(?:please\s+)?(?:open|launch|start)\s+"
        r"(?:it|that|this|the same|the same thing|that one)",
        q,
    ):
        scores["local_action"] += 0.40
        scores["website_action"] += 0.20

    if re.fullmatch(
        r"(?:please\s+)?(?:do|do exactly)\s+(?:the same|that)",
        q,
    ):
        scores["ambiguous"] += 0.45

    # --- Conversation/general language ---------------------------------
    if re.search(
        r"\b(?:hello|hi|hey|thanks|thank you|how are you|good morning|"
        r"good afternoon|good evening|tell me about yourself)\b",
        q,
    ):
        scores["conversation"] += 0.82

    if re.search(
        r"\b(?:why|how|explain|define|meaning|difference|compare|should i|"
        r"can you explain)\b",
        q,
    ):
        scores["general_question"] += 0.55

    # Remove impossible/weak categories in obvious local cases.
    if scores["local_fact"] >= 0.90 and not re.search(r"\b(?:news|headlines?|happenings?|current events?)\b", q):
        scores["web_research"] *= 0.05

    # Select top two intents.
    ranked = sorted(scores.items(), key=lambda item: item[1], reverse=True)
    best_intent, best_score = ranked[0]
    runner_up, runner_up_score = ranked[1]

    # Normalize to a probability-like confidence without pretending this is
    # a statistical model. The value is a routing confidence score.
    total = sum(max(v, 0.0) for _, v in ranked)
    if total > 0:
        best_confidence = min(1.0, best_score / max(total, best_score))
    else:
        best_confidence = 0.0

    runner_confidence = (
        min(1.0, runner_up_score / max(total, runner_up_score))
        if total > 0 else 0.0
    )

    ambiguous = (
        best_intent == "ambiguous"
        or best_confidence < INTENT_CONFIDENCE_THRESHOLD
        or (best_confidence - runner_confidence) < INTENT_MARGIN_THRESHOLD
    )

    return {
        "intent": best_intent,
        "confidence": round(best_confidence, 3),
        "runner_up": runner_up,
        "runner_up_confidence": round(runner_confidence, 3),
        "ambiguous": ambiguous,
    }


def confidence_for_local_intent(question):
    """Compatibility wrapper for existing callers."""
    return classify_intent(question)["confidence"]


def local_first_answer(question):
    """
    Phase 38: one clean entry point for deterministic local actions.
    """
    resolved = resolve_followup_reference(question)
    handled, result = local_intent_router(resolved)

    if handled:
        return True, result, resolved

    local_answer = check_local_answer(resolved)
    if local_answer:
        return True, local_answer, resolved

    volume_percent = check_set_volume(resolved)
    if volume_percent is not None:
        return True, set_volume_percent(volume_percent), resolved

    return False, None, resolved


def record_successful_intent(question, result_text):
    """
    Phase 39: remember only short-lived action context needed for follow-ups.
    Do not put arbitrary command output into persistent memory.
    """
    q = normalize_command_text(question)

    open_match = re.match(
        r"^(?:please )?(?:open|launch|start|go to)\s+(.+?)$",
        q,
    )
    if open_match:
        target = re.sub(
            r"\b(?:website|site|page)\b$", "", open_match.group(1)
        ).strip()
        update_conversation_state(
            last_action=target,
            last_opened=target,
            last_topic=target,
        )
        return

    site_search_match = re.match(
        r"^(?:please )?(?:search|find)\s+(.+?)\s+(?:on|in)\s+"
        r"(instagram|youtube|google|amazon|reddit|twitter|x)$",
        q,
    )
    if site_search_match:
        query_text = site_search_match.group(1).strip()
        site = site_search_match.group(2)
        update_conversation_state(
            last_action=query_text,
            last_search=query_text,
            last_site=site,
            last_topic=query_text,
        )
        return

    if result_text and len(q.split()) <= 12:
        # Keep only a lightweight topic candidate for immediate follow-ups.
        update_conversation_state(last_topic=q)


def compact_spoken_reply(reply):
    """Keep ordinary spoken replies concise without changing structured JSON."""
    if not reply:
        return reply

    raw = str(reply).strip()
    if raw.startswith("{") and raw.endswith("}"):
        return raw

    cleaned = clean_for_speech(raw)
    words = cleaned.split()

    if len(words) <= MAX_SPOKEN_WORDS:
        return cleaned

    # Prefer a natural sentence boundary.
    sentences = re.split(r"(?<=[.!?])\\s+", cleaned)
    kept = []
    count = 0

    for sentence in sentences:
        n = len(sentence.split())
        if kept and count + n > MAX_SPOKEN_WORDS:
            break
        kept.append(sentence)
        count += n
        if count >= 45:
            break

    result = " ".join(kept).strip()
    if result:
        return result
    return " ".join(words[:MAX_SPOKEN_WORDS]).rstrip(",;:") + "."


def naturalize_ai_reply(reply):
    """
    Phase 40: remove accidental tool-like formatting if the model returns
    plain text instead of a structured action.
    """
    if not reply:
        return reply
    cleaned = str(reply).strip()
    if cleaned.startswith("```") and cleaned.endswith("```"):
        cleaned = cleaned[3:-3].strip()
    return cleaned

# computer awareness, speed, conversation, and safety routing.



def direct_task_router(question):
    q = normalize_command_text(question)

    if re.fullmatch(
        r"(?:please\s+)?(?:play|put\s+on)\s+my\s+"
        r"(?:favorite|favourite)\s+(?:song|music)",
        q,
    ):
        favorite = get_named_preference("favorite song")
        if not favorite:
            return "I don't have your favorite song saved yet."
        opened = open_site("youtube")
        if "couldn't" in opened.lower() or "could not" in opened.lower():
            return opened
        return site_search_result("youtube", favorite)


    aliases = {
        "you tube": "youtube", "yt": "youtube",
        "youtube website": "youtube", "youtube site": "youtube",
        "insta": "instagram", "instagram website": "instagram",
        "vs code": "vscode", "visual studio code": "vscode",
        "microsoft edge": "edge", "edge browser": "edge",
        "calculator app": "calculator", "explorer": "file explorer",
    }

    def target_alias(value):
        value = normalize_command_text(value)
        value = re.sub(r"\b(?:website|site|page)\b$", "", value).strip()
        return aliases.get(value, value)

    # Compound: "open YouTube and search for Spider-Man Brand New Day"
    # or "open Edge and search for X" -- try the website form first, and
    # only if that doesn't apply, fall through (do NOT return) so the
    # app-plus-search form below still gets a chance.
    m = re.fullmatch(
        r"(?:please\s+)?(?:open|launch|start|go\s+to)\s+(.+?)\s+"
        r"(?:and|then)\s+(?:search|find|look\s+up)\s+(?:for\s+)?(.+)",
        q,
    )
    if m:
        site = target_alias(m.group(1))
        query = m.group(2).strip()
        if site in KNOWN_SITES and query:
            opened = open_site(site)
            if "couldn't" not in opened.lower() and "could not" not in opened.lower():
                return site_search_result(site, query)
            return opened
        # Not a known website -- fall through to the app-plus-search form.

    # Compound browser: "open Edge and search for ..."
    m = re.fullmatch(
        r"(?:please\s+)?(?:open|launch|start)\s+(.+?)\s+"
        r"(?:and|then)\s+(?:search|find|look\s+up)\s+(?:for\s+)?(.+)",
        q,
    )
    if m:
        app = target_alias(m.group(1))
        query = m.group(2).strip()
        if app in {"edge", "brave"} and query:
            opened = open_app(app)
            # Return the actual search result as the current response.
            return web_search_answer(query)

    # Exact laptop controls.
    power_patterns = (
        (r"^(?:please\s+)?(?:shut\s+down|shutdown)(?:\s+my)?\s+(?:laptop|computer|pc)$", "shutdown"),
        (r"^(?:please\s+)?(?:turn\s+off|power\s+off)(?:\s+my)?\s+(?:laptop|computer|pc)$", "shutdown"),
        (r"^(?:please\s+)?(?:restart|reboot)(?:\s+my)?\s+(?:laptop|computer|pc)$", "restart"),
        (r"^(?:please\s+)?lock(?:\s+my)?\s+(?:laptop|computer|pc|screen)$", "lock"),
        (r"^(?:please\s+)?(?:sleep|suspend)(?:\s+my)?\s+(?:laptop|computer|pc)$", "sleep"),
    )
    for pattern, action in power_patterns:
        if re.fullmatch(pattern, q):
            return system_control(action)

    # Volume.
    volume_map = {
        "volume up": "volume up", "increase volume": "volume up",
        "turn volume up": "volume up", "raise volume": "volume up",
        "louder": "volume up", "volume down": "volume down",
        "decrease volume": "volume down", "turn volume down": "volume down",
        "lower volume": "volume down", "quieter": "volume down",
        "mute": "mute", "mute volume": "mute", "mute the volume": "mute",
        "unmute": "unmute", "unmute volume": "unmute",
        "unmute the volume": "unmute",
    }
    if q in volume_map:
        return volume_control_action(volume_map[q])

    m = re.fullmatch(
        r"(?:please\s+)?(?:set|change|make|turn)\s+(?:the\s+)?volume\s+(?:to\s+)?(\d{1,3})%?",
        q,
    )
    if m:
        return set_volume_percent(min(100, max(0, int(m.group(1)))))

    # Single open.
    m = re.fullmatch(
        r"(?:please\s+)?(?:open|launch|start|go\s+to)\s+(.+)",
        q,
    )
    if m:
        target = target_alias(m.group(1))
        if target in KNOWN_SITES:
            return open_site(target)
        if target in APP_MAP:
            return open_app(target)
        if re.fullmatch(r"(?:https?://)?[a-z0-9-]+\.[a-z]{2,}(?:/.*)?", target):
            return open_site(target)

    # Single close.
    m = re.fullmatch(r"(?:please\s+)?(?:close|quit|exit)\s+(.+)", q)
    if m:
        target = target_alias(m.group(1))
        if target in KNOWN_SITES or target in APP_MAP or target in {"youtube","youtube tab","youtube video"}:
            return close_app(target)

    # Website search.
    m = re.fullmatch(
        r"(?:please\s+)?(?:search|find|look\s+up)\s+(.+?)\s+"
        r"(?:on|in)\s+(youtube|google|amazon|instagram|reddit|twitter|x)",
        q,
    )
    if m:
        return site_search_result(m.group(2), m.group(1).strip())

    # Generic explicit web search.
    m = re.fullmatch(r"(?:please\s+)?(?:search|look\s+up|find)\s+(.+)", q)
    if m:
        return web_search_answer(m.group(1).strip())

    if q in {"show desktop", "show the desktop", "minimize all windows"}:
        return show_desktop()

    media_map = {
        "play": "play", "resume": "play", "resume playback": "play",
        "pause": "pause", "next": "next", "next track": "next",
        "next video": "next", "previous": "previous",
        "previous track": "previous", "previous video": "previous",
    }
    if q in media_map:
        return media_key_action(media_map[q])

    return None


def site_search_result(site, query):
    if site not in SITE_SEARCH_URLS:
        return f"I can't search {site} directly."
    try:
        url=SITE_SEARCH_URLS[site].format(quote_plus(query))
        if webbrowser.open(url) is False:
            return f"I couldn't search {site}."
        return f"Searching {site} for {query}."
    except Exception as e:
        print(f"DEBUG: Site search failed: {e}")
        return f"I couldn't search {site}."


def media_key_action(command):
    if os.name != "nt":
        return "Media controls are available only on Windows."
    keys={"play":0xB3,"pause":0xB3,"resume":0xB3,"next":0xB0,"next track":0xB0,"previous":0xB1,"previous track":0xB1}
    key=keys.get(command)
    if key is None: return "I don't know that media command."
    try:
        ctypes.windll.user32.keybd_event(key,0,0,0)
        ctypes.windll.user32.keybd_event(key,0,0x0002,0)
        return "Done."
    except Exception as e:
        print(f"DEBUG: Media key failed: {e}")
        return "I couldn't control media playback."


def handle_question(question, conversation):
    if is_assistant_shutdown_command(question):
        speak("Shutting down Jarvis.")
        request_shutdown()
        return ""

    resolved_question = resolve_followup_reference(question)
    q = normalize_command_text(resolved_question)

    direct_result = direct_task_router(resolved_question)
    if direct_result is not None:
        record_successful_intent(resolved_question, direct_result)
        return direct_result

    # Live information gets priority over all local facts.
    if re.search(
        r"\b(?:news|headlines?|happenings?|current events?|"
        r"latest updates?|breaking|what happened)\b",
        q,
    ):
        result = web_search_answer(resolved_question)
        record_successful_intent(resolved_question, result)
        return result

    # Calendar/festival facts are not the same as asking for the date.
    if re.search(
        r"\b(?:today|this year|current)\b.*\b(?:teacher'?s? day|"
        r"festival|holiday|independence day|republic day)\b",
        q,
    ):
        result = web_search_answer(resolved_question)
        record_successful_intent(resolved_question, result)
        return result

    # Live news/current happenings are never local RAM/date facts.
    if re.search(
        r"\b(?:news|headlines?|happenings?|current events?|breaking|latest updates?)\b",
        q,
    ):
        result = web_search_answer(resolved_question)
        record_successful_intent(resolved_question, result)
        return result

    # Calendar/current-event facts like "Is today Teacher's Day?" are not the
    # same as asking for the computer's date. Use fresh external information.
    calendar_fact = re.search(
        r"\b(?:today|this year|current)\b.*\b(?:day|festival|holiday|"
        r"teachers? day|independence day|republic day)\b",
        q,
    )
    if calendar_fact and not re.fullmatch(
        r"(?:what(?:'s| is)|tell me|give me|show me)\s+(?:the\s+)?"
        r"(?:current\s+)?(?:date|day)",
        q,
    ):
        result = web_search_answer(resolved_question)
        record_successful_intent(resolved_question, result)
        return result

    # Current events/news/date-dependent facts are web questions, not local
    # computer facts. This prevents phrases like "today's news in India"
    # from ever being answered with the computer's calendar date.
    current_event = re.search(
        r"\b(?:today|right now|currently|current|latest|recent|news|"
        r"happening|happenings|headlines|updates?)\b",
        q,
    )
    explicit_news = re.search(
        r"\b(?:news|happening|happenings|headlines|latest updates?|"
        r"current events?)\b",
        q,
    )
    date_only = re.fullmatch(
        r"(?:what(?:'s| is)|tell me|give me|show me)\s+"
        r"(?:the\s+)?(?:current\s+)?(?:date|day|today(?:'s)? date)",
        q,
    )
    if current_event and explicit_news and not date_only:
        result = web_search_answer(resolved_question)
        record_successful_intent(resolved_question, result)
        return result

    # Deterministic local commands/facts first.
    handled, local_result, resolved_question = local_first_answer(
        resolved_question
    )
    if handled:
        record_successful_intent(resolved_question, local_result)
        return local_result

    volume_percent = check_set_volume(resolved_question)
    if volume_percent is not None:
        result = set_volume_percent(volume_percent)
        record_successful_intent(resolved_question, result)
        return result

    classification = classify_intent(resolved_question)
    intent = classification["intent"]

    action_words = re.search(
        r"\b(open|launch|start|close|quit|show|hide|lock|sleep|restart|"
        r"shutdown|search|find|look up|mute|unmute|increase|decrease)\b",
        q,
    )
    if action_words and classification["ambiguous"]:
        return "I didn't catch that command clearly. Please say it again."


    # Current/live external information uses the web.
    if intent == "web_research" and should_force_web_search(resolved_question):
        result = web_search_answer(resolved_question)
        record_successful_intent(resolved_question, result)
        return result

    computer_context = build_computer_context()
    conversation.append({
        "role": "user",
        "content": (
            resolved_question
            + "\n\n[LOCAL COMPUTER CONTEXT FOR THIS TURN: "
            + computer_context
            + "]"
        ),
    })

    signals.status_changed.emit("thinking")

    reply = ask_groq(conversation)
    reply = naturalize_ai_reply(reply)

    # Parse tools BEFORE any spoken-answer shortening.
    action, target = try_parse_command(reply)

    if action:
        original = normalize_command_text(resolved_question)

        # The LLM may propose an action, but it cannot authorize one.
        # The actual transcript must explicitly support the action type.
        if not validate_tool_request(original, action, target):
            print(
                f"DEBUG: Blocked unsupported AI action: "
                f"action={action!r}, target={target!r}, question={original!r}"
            )
            return "I didn't catch that command clearly. Please say it again."

        result = execute_tool(action, target)
        if result is not None:
            record_successful_intent(resolved_question, result)
            return result

    # Only plain-language answers get compacted.
    reply = compact_spoken_reply(reply)
    conversation.append({"role": "assistant", "content": reply})
    record_successful_intent(resolved_question, reply)
    return reply



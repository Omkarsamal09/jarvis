def open_site(target):
    """Open only recognized site names or explicit domains."""
    target_clean = normalize_command_text(target)
    target_clean = re.sub(
        r"\b(?:website|site|page)\b$", "", target_clean
    ).strip()

    aliases = {
        "you tube": "youtube",
        "youtube dot com": "youtube",
        "insta": "instagram",
        "instagram dot com": "instagram",
        "google dot com": "google",
        "gmail dot com": "gmail",
        "whatsapp web": "whatsapp",
        "twitter dot com": "twitter",
        "x dot com": "x",
    }
    target_clean = aliases.get(target_clean, target_clean)

    if target_clean in KNOWN_SITES:
        site_name = target_clean
        try:
            opened = webbrowser.open(KNOWN_SITES[site_name])
            return (
                f"Launching {site_name}."
                if opened is not False
                else f"I couldn't launch {site_name}."
            )
        except Exception as e:
            print(f"DEBUG: Could not launch {site_name}: {e}")
            return f"I couldn't launch {site_name}."

    # Never fuzzy-match an unrecognized spoken target to a random site.
    domain_pattern = (
        r"(?:https?://)?[a-z0-9-]+\.[a-z]{2,}"
        r"(?:/[\w./?%&=+#:-]*)?"
    )
    if re.fullmatch(domain_pattern, target_clean):
        url = (
            target_clean
            if re.match(r"^https?://", target_clean)
            else "https://" + target_clean
        )
        try:
            opened = webbrowser.open(url)
            return (
                "Launching the website."
                if opened is not False
                else "I couldn't launch that website."
            )
        except Exception as e:
            print(f"DEBUG: Could not launch website: {e}")
            return "I couldn't launch that website."

    return f"I don't recognize the website {target_clean}."



def _find_visible_window_by_title(target):
    """Return the first visible window whose title contains target."""
    if not target:
        return None

    target = target.strip().lower()
    user32 = ctypes.windll.user32
    results = []
    WNDENUMPROC = ctypes.WINFUNCTYPE(ctypes.c_bool, ctypes.c_void_p, ctypes.c_void_p)

    def enum_proc(hwnd, lparam):
        if not user32.IsWindowVisible(hwnd):
            return True
        length = user32.GetWindowTextLengthW(hwnd)
        if length <= 0:
            return True
        buf = ctypes.create_unicode_buffer(length + 1)
        user32.GetWindowTextW(hwnd, buf, length + 1)
        title = buf.value.strip()
        if title and target in title.lower():
            results.append((hwnd, title))
            return False
        return True

    user32.EnumWindows(WNDENUMPROC(enum_proc), 0)
    return results[0] if results else None


def _send_ctrl_w():
    """Close only the active browser tab."""
    user32 = ctypes.windll.user32
    VK_CONTROL = 0x11
    VK_W = 0x57
    KEYEVENTF_KEYUP = 0x0002

    user32.keybd_event(VK_CONTROL, 0, 0, 0)
    user32.keybd_event(VK_W, 0, 0, 0)
    user32.keybd_event(VK_W, 0, KEYEVENTF_KEYUP, 0)
    user32.keybd_event(VK_CONTROL, 0, KEYEVENTF_KEYUP, 0)


def _activate_window(hwnd):
    user32 = ctypes.windll.user32
    try:
        user32.ShowWindow(hwnd, 5)
        user32.SetForegroundWindow(hwnd)
        time.sleep(0.12)
        return True
    except Exception:
        return False


def _windows_close_window_by_title(target):
    """Close a matching browser tab safely when possible; otherwise close a window."""
    target = normalize_command_text(target)

    # YouTube is explicitly tab-scoped: never destroy the whole browser window.
    if target in {"youtube", "youtube tab", "youtube video"}:
        match = _find_visible_window_by_title("youtube")
        if not match:
            return None

        hwnd, title = match
        active_title = get_active_window_title() or ""
        if "youtube" not in active_title.lower():
            if not _activate_window(hwnd):
                return None

        _send_ctrl_w()
        return f"Closed the YouTube tab."

    match = _find_visible_window_by_title(target)
    if not match:
        return None

    hwnd, title = match
    try:
        ctypes.windll.user32.PostMessageW(hwnd, 0x0010, 0, 0)  # WM_CLOSE
        return title
    except Exception:
        return None


def open_app(app_name):
    app_name = normalize_command_text(app_name)

    aliases = {
        "visual studio code": "vscode",
        "vs code": "vscode",
        "microsoft edge": "edge",
        "edge browser": "edge",
    }
    app_name = aliases.get(app_name, app_name)

    if app_name not in APP_MAP:
        return f"I don't know how to open {app_name} yet."

    command = APP_MAP[app_name]

    try:
        process = subprocess.Popen(
            command,
            shell=True,
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
        )
        if process.poll() is None:
            return f"Launching {app_name}."
        return f"I couldn't launch {app_name}."
    except OSError as e:
        print(f"DEBUG: Could not open {app_name}: {e}")
        return f"I couldn't launch {app_name}."


def close_app(app_name):
    """Close an app/window conservatively without force-killing processes."""
    app_name = normalize_command_text(app_name)

    aliases = {
        "visual studio code": "vscode",
        "vs code": "vscode",
        "microsoft edge": "edge",
        "edge browser": "edge",
    }
    app_name = aliases.get(app_name, app_name)

    title_match = _windows_close_window_by_title(app_name)
    if title_match:
        if app_name in {"youtube", "youtube tab", "youtube video"}:
            return title_match
        return f"Closed {title_match}."

    return f"I couldn't find a visible window for {app_name}."


def show_desktop():
    try:
        ctypes.windll.user32.keybd_event(0x5B, 0, 0, 0)
        ctypes.windll.user32.keybd_event(0x44, 0, 0, 0)
        ctypes.windll.user32.keybd_event(0x44, 0, 0x0002, 0)
        ctypes.windll.user32.keybd_event(0x5B, 0, 0x0002, 0)

        # Win+D can keep the previous app as the reported foreground window.
        # Ask the Qt HUD to expand on its own UI thread immediately, then the
        # normal 100 ms mode sync will take over when another app is restored.
        if orb_instance is not None:
            try:
                QTimer.singleShot(120, lambda: orb_instance._set_expanded(False, force=True))
            except Exception:
                pass
        return "Showing desktop"
    except Exception:
        return "Sorry, I couldn't show the desktop"



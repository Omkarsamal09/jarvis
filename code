def system_health_monitor_loop():
    """Warn only for sustained, meaningful system-health issues."""
    state = {
        "ram_since": None,
        "cpu_since": None,
        "disk_since": None,
        "ram_warned": False,
        "cpu_warned": False,
        "disk_warned": False,
    }

    while not shutdown_event.is_set():
        now = time.time()

        try:
            ram = float(psutil.virtual_memory().percent)
            if ram >= 96:
                state["ram_since"] = state["ram_since"] or now
                if now - state["ram_since"] >= 30 and not state["ram_warned"]:
                    state["ram_warned"] = True
                    speak(
                        "Sir, RAM usage is above 96 percent.",
                        allow_barge_in=False,
                    )
            else:
                state["ram_since"] = None
                state["ram_warned"] = False
        except Exception:
            pass

        try:
            cpu = float(psutil.cpu_percent(interval=0.1))
            if cpu >= 95:
                state["cpu_since"] = state["cpu_since"] or now
                if now - state["cpu_since"] >= 45 and not state["cpu_warned"]:
                    state["cpu_warned"] = True
                    speak(
                        "Sir, CPU usage has been unusually high.",
                        allow_barge_in=False,
                    )
            else:
                state["cpu_since"] = None
                state["cpu_warned"] = False
        except Exception:
            pass

        try:
            disk = float(psutil.disk_usage("C:\\").percent)
            if disk >= 90:
                state["disk_since"] = state["disk_since"] or now
                if now - state["disk_since"] >= 10 and not state["disk_warned"]:
                    state["disk_warned"] = True
                    speak(
                        "Sir, your main drive is nearly full.",
                        allow_barge_in=False,
                    )
            else:
                state["disk_since"] = None
                state["disk_warned"] = False
        except Exception:
            pass

        for _ in range(30):
            if shutdown_event.is_set():
                return
            time.sleep(1)


def battery_monitor_loop():
    """Warn once when battery falls to 20% or lower."""
    while not shutdown_event.is_set():
        try:
            battery = psutil.sensors_battery()

            if battery is None:
                time.sleep(60)
                continue

            percent = float(battery.percent)

            with battery_alert_lock:
                warned = bool(battery_alert_state.get("warned", False))

                if percent <= 20.0 and not warned:
                    battery_alert_state["warned"] = True
                    should_warn = True
                elif percent > 20.0:
                    battery_alert_state["warned"] = False
                    should_warn = False
                else:
                    should_warn = False

            if should_warn:
                speak(
                    "Low battery, sir.",
                    allow_barge_in=False,
                )

        except Exception as e:
            print(f"DEBUG: Battery monitor failed: {e}")

        # One-minute polling is enough for a 20% threshold and avoids
        # unnecessary background work.
        for _ in range(60):
            if shutdown_event.is_set():
                return
            time.sleep(1)

def reminder_checker_loop():
    while not shutdown_event.is_set():
        time.sleep(20)
        now = datetime.now()
        due = []

        with reminders_lock:
            still_pending = []

            for reminder in reminders:
                try:
                    reminder_time = datetime.fromisoformat(reminder["time"])
                except (KeyError, TypeError, ValueError):
                    print("WARNING: Skipping malformed reminder.")
                    continue

                if reminder_time <= now:
                    due.append(reminder)
                else:
                    still_pending.append(reminder)

            reminders[:] = still_pending

            if due:
                try:
                    save_reminders(reminders)
                except OSError as e:
                    print(f"WARNING: Could not save reminders: {e}")

        for reminder in due:
            with conversation_lock:
                if stream is not None:
                    speak(f"Reminder: {reminder['text']}", allow_barge_in=False)
                else:
                    print(f"REMINDER: {reminder['text']}")



def add_reminder(text, when_phrase):
    parsed = dateparser.parse(
        when_phrase,
        settings={"PREFER_DATES_FROM": "future", "RETURN_AS_TIMEZONE_AWARE": False},
    )
    if not parsed:
        return None
    with reminders_lock:
        reminders.append({
            "id": str(uuid.uuid4()),
            "text": text,
            "time": parsed.isoformat()
        })
        save_reminders(reminders)
    return parsed


def set_reminder_action(target):
    try:
        text, when_phrase = target.split("|", 1)
    except ValueError:
        return "I need both what to remind you of and when."
    parsed = add_reminder(text.strip(), when_phrase.strip())
    if not parsed:
        return "I couldn't understand that time."
    friendly_time = parsed.strftime("%I:%M %p on %B %d")
    return f"Got it. I'll remind you to {text.strip()} at {friendly_time}."



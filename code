def load_reminders():
    """Load only valid reminder records so one bad entry cannot break reminders."""
    if not os.path.exists(REMINDERS_FILE):
        return []

    try:
        with open(REMINDERS_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, json.JSONDecodeError, TypeError, ValueError) as e:
        print(f"WARNING: Could not load reminders: {e}")
        return []

    if not isinstance(data, list):
        return []

    valid = []
    for item in data:
        if not isinstance(item, dict):
            continue
        reminder_text = str(item.get("text", "")).strip()
        reminder_time = str(item.get("time", "")).strip()
        if not reminder_text or not reminder_time:
            continue
        try:
            datetime.fromisoformat(reminder_time)
        except (TypeError, ValueError):
            continue

        valid.append({
            "id": str(item.get("id") or uuid.uuid4()),
            "text": reminder_text,
            "time": reminder_time,
        })

    return valid


def save_reminders(reminders):
    with open(REMINDERS_FILE, "w") as f:
        json.dump(reminders, f)



def is_assistant_shutdown_command(question):
    """Only an explicit command naming JARVIS can close the assistant."""
    q = normalize_command_text(question)
    explicit_phrases = (
        "shut down jarvis",
        "shutdown jarvis",
        "shut jarvis down",
        "exit jarvis",
        "quit jarvis",
        "close jarvis",
        "turn off jarvis",
        "terminate jarvis",
        "stop jarvis",
    )
    return q in explicit_phrases









def request_shutdown():
    """Thread-safe shutdown entry point."""
    try:
        if threading.current_thread() is threading.main_thread():
            _perform_shutdown()
        else:
            if "signals" in globals():
                signals.shutdown_requested.emit()
            else:
                _perform_shutdown()
    except Exception as e:
        print(f"WARNING: Shutdown request failed: {e}")


def _perform_shutdown():
    """Cleanly terminate JARVIS and remove its interface from the desktop."""
    global shutdown_event

    if shutdown_event.is_set():
        return

    shutdown_event.set()

    try:
        pygame.mixer.music.stop()
        pygame.mixer.music.unload()
    except Exception:
        pass

    try:
        if stream is not None:
            stream.stop_stream()
            stream.close()
    except Exception:
        pass

    try:
        if mic is not None:
            mic.terminate()
    except Exception:
        pass

    for temp_file in (TTS_FILE, QUESTION_WAV):
        try:
            if os.path.exists(temp_file):
                os.remove(temp_file)
        except OSError:
            pass

    try:
        if orb_instance is not None:
            getattr(orb_instance, "_timer", None).stop() if getattr(orb_instance, "_timer", None) else None
            orb_instance.hide()
            orb_instance.close()
            orb_instance.deleteLater()
    except Exception as e:
        print(f"WARNING: HUD cleanup failed: {e}")

    try:
        if app_instance is not None:
            app_instance.quit()
    except Exception:
        pass








def reset_to_wake_mode():
    """Immediately cancel the active interaction and return to wake-word mode."""
    manual_wake_reset_event.set()
    speech_stop_event.set()
    external_audio_interrupt_event.clear()
    try:
        pygame.mixer.music.stop()
    except Exception:
        pass
    try:
        flush_stream()
    except Exception:
        pass
    try:
        if wake_model is not None:
            wake_model.reset()
    except Exception:
        pass
    signals.status_changed.emit("idle")
    print("INFO: Manual reset -> wake-word mode.")

def is_stop_command(text):
    q = normalize_command_text(text)
    q = re.sub(r"[^\w\s]", "", q).strip()
    return q in {
        "stop", "stop it", "stop now", "please stop",
        "stop talking", "stop speaking", "be quiet", "quiet",
        "thats enough", "that's enough", "cancel", "cancel that",
        "never mind", "nevermind",
    } or (
        len(q.split()) <= 2
        and q.replace(" ", "") in {"stop", "stopp", "stap", "stoop", "stob"}
    )


def is_standby_command(text):
    q = normalize_command_text(text)
    q = re.sub(r"[^\w\s]", "", q).strip()
    return q in {
        "stand by", "standby", "go standby", "jarvis stand by",
        "go on standby", "enter standby",
    }




def jarvis_voice_loop():
    speak(get_greeting(), allow_barge_in=False)
    time.sleep(0.5)
    flush_stream()

    try:
        wake_model.reset()
    except Exception:
        pass

    signals.status_changed.emit("idle")
    global active_conversation

    FOLLOWUP_WINDOW = 15.0
    FOLLOWUP_NO_SPEECH = 5.0
    POST_STOP_LISTEN_WINDOW = 15.0

    while not shutdown_event.is_set():
        try:
            if manual_wake_reset_event.is_set():
                manual_wake_reset_event.clear()
                speech_stop_event.clear()
                flush_stream()
                try:
                    wake_model.reset()
                except Exception:
                    pass
                signals.status_changed.emit("idle")
                time.sleep(0.05)
                continue

            if stream is None or not stream.is_active():
                if not recover_audio_stream():
                    time.sleep(1.0)
                    continue

            if laptop_audio_is_playing():
                flush_stream()
                signals.status_changed.emit("idle")
                try:
                    wake_model.reset()
                except Exception:
                    pass
                time.sleep(0.05)
                continue

            try:
                chunk = np.frombuffer(
                    stream.read(1280, exception_on_overflow=False),
                    dtype=np.int16,
                )
            except Exception as e:
                msg = str(e).lower()
                if "stream" in msg or "-9983" in msg:
                    recover_audio_stream()
                    continue
                raise

            if chunk.size == 0:
                continue

            prediction = wake_model.predict(chunk)
            score = max(
                (float(v) for v in prediction.values()),
                default=0.0,
            )

            if score < WAKE_SCORE_THRESHOLD:
                continue

            flush_stream()
            external_audio_interrupt_event.clear()
            clear_external_audio_detector()

            with conversation_lock:
                active_conversation = [
                    {"role": "system", "content": build_system_prompt()}
                ]

                speak("Yes sir?", allow_barge_in=False)
                flush_stream()

                # TTS has just finished.  Clear any meter hysteresis caused by
                # the transition so JARVIS never mistakes its own acknowledgement
                # for external laptop audio.
                clear_external_audio_detector()
                listening_deadline = time.time() + FOLLOWUP_WINDOW
                fast_start = False

                while not shutdown_event.is_set():
                    if manual_wake_reset_event.is_set():
                        manual_wake_reset_event.clear()
                        flush_stream()
                        try:
                            wake_model.reset()
                        except Exception:
                            pass
                        signals.status_changed.emit("idle")
                        break

                    # Any media/audio starting on the laptop cancels the
                    # current interaction and returns to wake-word standby.
                    if laptop_audio_is_playing():
                        flush_stream()
                        external_audio_interrupt_event.clear()
                        clear_external_audio_detector()
                        signals.status_changed.emit("idle")
                        try:
                            wake_model.reset()
                        except Exception:
                            pass
                        break

                    if time.time() >= listening_deadline:
                        signals.status_changed.emit("idle")
                        break

                    remaining = listening_deadline - time.time()

                    question = listen_for_question(
                        timeout=min(FOLLOWUP_NO_SPEECH, remaining),
                        max_seconds=min(MAX_COMMAND_SECONDS, remaining),
                        fast_start=fast_start,
                    )
                    fast_start = False

                    if external_audio_interrupt_event.is_set():
                        # The listener detected external laptop audio while it
                        # was recording.  Never send that audio to Whisper.
                        external_audio_interrupt_event.clear()
                        flush_stream()
                        clear_external_audio_detector()
                        signals.status_changed.emit("idle")
                        try:
                            wake_model.reset()
                        except Exception:
                            pass
                        break

                    if not question:
                        # Do NOT reset listening_deadline here.
                        # Silence therefore expires after 15 seconds total.
                        if time.time() >= listening_deadline:
                            signals.status_changed.emit("idle")
                            break
                        continue

                    if is_standby_command(question):
                        flush_stream()
                        try:
                            wake_model.reset()
                        except Exception:
                            pass
                        signals.status_changed.emit("idle")
                        break

                    if is_stop_command(question):
                        # STOP ends the current response/listening action and
                        # opens one fresh 15-second command window.
                        signals.status_changed.emit("listening")
                        flush_stream()
                        listening_deadline = time.time() + POST_STOP_LISTEN_WINDOW
                        fast_start = True
                        continue

                    if laptop_audio_is_playing():
                        flush_stream()
                        signals.status_changed.emit("idle")
                        try:
                            wake_model.reset()
                        except Exception:
                            pass
                        break

                    result_text = handle_question(
                        question,
                        active_conversation,
                    )

                    if shutdown_event.is_set():
                        break

                    if not result_text:
                        listening_deadline = time.time() + FOLLOWUP_WINDOW
                        continue

                    if laptop_audio_is_playing():
                        flush_stream()
                        signals.status_changed.emit("idle")
                        try:
                            wake_model.reset()
                        except Exception:
                            pass
                        break

                    signals.status_changed.emit("speaking")
                    was_interrupted = speak(
                        result_text,
                        allow_barge_in=True,
                    )

                    if was_interrupted:
                        flush_stream()
                        time.sleep(0.08)

                        if external_audio_interrupt_event.is_set():
                            # YouTube/music/another app started playing while
                            # JARVIS was speaking. Do NOT listen to it.
                            external_audio_interrupt_event.clear()
                            signals.status_changed.emit("idle")
                            try:
                                wake_model.reset()
                            except Exception:
                                pass
                            break

                        # Human interruption: stop the answer and listen for
                        # one fresh command for at most 15 seconds.
                        signals.status_changed.emit("listening")
                        listening_deadline = time.time() + POST_STOP_LISTEN_WINDOW
                        fast_start = True
                        continue

                    flush_stream()

                    if laptop_audio_is_playing():
                        signals.status_changed.emit("idle")
                        try:
                            wake_model.reset()
                        except Exception:
                            pass
                        break

                    # After a completed response, wait up to 15 seconds for
                    # another command, then automatically return to wake mode.
                    listening_deadline = time.time() + FOLLOWUP_WINDOW

            flush_stream()

            try:
                wake_model.reset()
            except Exception:
                pass

            external_audio_interrupt_event.clear()
            signals.status_changed.emit("idle")
            time.sleep(0.18)

        except Exception as e:
            if shutdown_event.is_set():
                break

            msg = str(e).lower()
            if "-9983" not in msg and "stream is stopped" not in msg:
                print(f"WARNING: Voice loop error: {e}")

            try:
                if not recover_audio_stream():
                    time.sleep(1.0)
                wake_model.reset()
            except Exception:
                pass

            external_audio_interrupt_event.clear()
            signals.status_changed.emit("idle")
            time.sleep(0.5)



def get_named_preference(name):
    n = normalize_command_text(name)
    aliases = {
        "favorite song": ["favorite song", "favourite song"],
        "favorite music": ["favorite song", "favourite song", "favorite music", "favourite music"],
    }
    terms = aliases.get(n, [n])

    with memory_lock:
        items = [m for m in memories if isinstance(m, dict)]

    for item in reversed(items):
        original = str(item.get("text", "")).strip()
        value = normalize_command_text(original)
        if any(term in value for term in terms):
            match = re.search(
                r"(?:my\s+)?(?:favorite|favourite)\s+(?:song|music)\s*(?:is|=|:)\s*(.+)$",
                original,
                re.IGNORECASE,
            )
            if match:
                return match.group(1).strip()
            return original
    return None


def remember_action(text):
    text = re.sub(r"\s+", " ", text).strip()
    if not text:
        return "I need something to remember."
    with memory_lock:
        existing = {m.get("text", "").strip().lower() for m in memories if isinstance(m, dict)}
        if text.lower() not in existing:
            memories.append({"id": str(uuid.uuid4()), "text": text, "created": datetime.now().isoformat(timespec="seconds")})
            save_memories(memories)
            return f"Got it. I'll remember that {text}."
    return "I already remember that."


def forget_memory_action(target):
    target = re.sub(r"\s+", " ", target).strip().lower()
    if not target:
        return "Tell me what you want me to forget."
    with memory_lock:
        matches = [m for m in memories if target in m.get("text", "").lower()]
        if not matches:
            return "I couldn't find a memory matching that."
        memories[:] = [m for m in memories if target not in m.get("text", "").lower()]
        save_memories(memories)
    return f"Done. I forgot {matches[0].get('text', target)}."



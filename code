def initialize_jarvis_services():
    global groq_client, wake_model, mic, stream, volume_control
    print("Initializing JARVIS services...")

    try:
        groq_client = Groq(api_key=os.getenv("GROQ_API_KEY"))
        pygame.mixer.init()
        wake_model = WakeModel(
            wakeword_models=["hey_jarvis"],
            inference_framework="onnx"
        )

        if pyaudio is None:
            raise RuntimeError(
                "PyAudio is not available in this Python environment."
            )

        mic = pyaudio.PyAudio()

        # Always prefer Windows/PyAudio's current default microphone.
        # Hard-coded device indexes are fragile because Windows can renumber
        # devices after plugging/unplugging hardware.
        stream_kwargs = {
            "format": pyaudio.paInt16,
            "channels": 1,
            "rate": 16000,
            "input": True,
            "frames_per_buffer": 1280,
        }
        try:
            default_input = mic.get_default_input_device_info()
            stream_kwargs["input_device_index"] = int(default_input["index"])
        except Exception:
            pass

        stream = mic.open(**stream_kwargs)

        try:
            devices = AudioUtilities.GetSpeakers()
            interface = devices.Activate(
                IAudioEndpointVolume._iid_, CLSCTX_ALL, None
            )
            volume_control = cast(
                interface, POINTER(IAudioEndpointVolume)
            )
        except Exception as e:
            # Volume control is optional; voice recognition should still work.
            print(f"WARNING: Windows volume control unavailable: {e}")
            volume_control = None

        print("JARVIS services ready.")
        return True

    except Exception as e:
        print(f"WARNING: JARVIS audio/service startup failed: {e}")
        stream = None
        mic = None
        wake_model = None
        return False


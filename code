                pass

        if mic is None:
            mic = pyaudio.PyAudio()

        kwargs = {
            "format": pyaudio.paInt16,
            "channels": 1,
            "rate": 16000,
            "input": True,
            "frames_per_buffer": 1280,
        }
        try:
            device = mic.get_default_input_device_info()
            kwargs["input_device_index"] = int(device["index"])
        except Exception:
            pass

        stream = mic.open(**kwargs)
        print("INFO: Microphone stream recovered.")
        return True
    except Exception as e:
        print(f"WARNING: Microphone recovery failed: {e}")
        return False


def flush_stream():
    if stream is None or shutdown_event.is_set():
        return
    try:
        if hasattr(stream, "is_active") and not stream.is_active():
            return
    except Exception:
        return
    try:
        available = int(stream.get_read_available())
        while available > 0 and not shutdown_event.is_set():
            stream.read(min(available, 2048), exception_on_overflow=False)
            available = int(stream.get_read_available())
    except Exception as e:
        msg = str(e).lower()
        if "-9983" not in msg and "stream is stopped" not in msg:
            print(f"DEBUG: Could not flush audio stream: {e}")


def validate_tool_request(original_question, action, target):
    """Independent safety firewall for AI-generated actions."""
    q = normalize_command_text(original_question)
    t = normalize_command_text(target or "")

    if action == "assistant_shutdown":
        return is_assistant_shutdown_command(q)

    if action == "system_control":
        allowed = {
            "shutdown", "restart", "lock", "sleep",
            "shut down", "turn off", "power off", "reboot",
            "lock screen",
        }
        return any(term == t for term in allowed) and bool(
            re.search(r"\b(shut\s*down|shutdown|turn\s+off|power\s+off|"
                      r"restart|reboot|lock|sleep)\b", q)
        )

    if action == "open_app":
        return bool(re.search(r"\b(open|launch|start)\b", q)) and t in APP_MAP

    if action == "close_app":
        return bool(re.search(r"\b(close|quit)\b", q)) and bool(t)

    if action == "open_site":
        return bool(re.search(r"\b(open|launch|start|go\s+to)\b", q)) and bool(t)

    if action == "site_search":
        return bool(re.search(r"\b(search|find|look\s+up)\b", q)) and "|" in str(target)

    if action == "web_search":
        return bool(re.search(r"\b(search|find|look\s+up|latest|news|what|who|how|why)\b", q))

    if action == "volume_control":
        return bool(re.search(r"\b(volume|mute|unmute|sound)\b", q))

    if action in {"set_reminder", "list_reminders"}:
        return bool(re.search(r"\b(remind|reminder)\b", q)) or action == "list_reminders"

    if action in {"remember", "forget_memory", "list_memory"}:
        return bool(re.search(r"\b(remember|forget|memory)\b", q))

    if action == "show_desktop":
        return bool(re.search(r"\b(show\s+desktop|minimize\s+all)\b", q))

    return False



def web_search_answer(query):
    """Search the web; use the dedicated news index for current-news requests."""
    signals.status_changed.emit("searching")

    q = normalize_command_text(query)
    news_query = bool(
        re.search(
            r"\b(?:news|headline|headlines|happening|happenings|"
            r"current events|latest updates?|breaking)\b",
            q,
        )
    )

    try:
        with DDGS() as ddgs:
            if news_query:
                # DDGS has a dedicated news search with date limiting and
                # structured article metadata (title/body/source/date).
                today = datetime.now().strftime("%Y-%m-%d")
                search_query = query
                if "today" not in q and "latest" not in q and "current" not in q:
                    search_query = f"{query} latest news {today}"

                raw_results = list(
                    ddgs.news(
                        query=search_query,
                        region="in-en",
                        safesearch="moderate",
                        timelimit="d",
                        max_results=10,
                    )
                )
            else:
                raw_results = list(
                    ddgs.text(
                        query=query,
                        region="in-en",
                        safesearch="moderate",
                        max_results=7,
                    )
                )

        seen = set()
        results = []
        for result in raw_results:
            title = str(result.get("title", "")).strip()
            body = str(result.get("body", "")).strip()
            url = str(result.get("url") or result.get("href") or "").strip()
            source = str(result.get("source", "")).strip()
            date = str(result.get("date", "")).strip()

            key = (
                title.lower(),
                body.lower(),
                url.lower(),
            )
            if key in seen or not title:
                continue
            seen.add(key)

            # Drop obvious outlet homepages / navigation-only results.
            text_blob = f"{title} {body}".lower()
            homepage_only = (
                not body
                and any(
                    word in text_blob
                    for word in (
                        "google news", "bbc", "times of india",
                        "india today", "new indian express",
                    )
                )
            )
            if homepage_only:
                continue

            results.append({
                "title": title,
                "body": body,
                "url": url,
                "source": source,
                "date": date,
            })

        # Retry with a more explicit current-news query if a news search
        # returned only weak/navigation-like entries.
        if news_query and len(results) < 3:
            fallback_query = f"{query} latest India news today"
            try:
                with DDGS() as ddgs:
                    fallback = list(
                        ddgs.news(
                            query=fallback_query,
                            region="in-en",
                            safesearch="moderate",
                            timelimit="d",
                            max_results=10,
                        )
                    )
                for result in fallback:
                    title = str(result.get("title", "")).strip()
                    body = str(result.get("body", "")).strip()
                    url = str(result.get("url") or result.get("href") or "").strip()
                    source = str(result.get("source", "")).strip()
                    date = str(result.get("date", "")).strip()
                    key = (title.lower(), body.lower(), url.lower())
                    if title and key not in seen and body:
                        seen.add(key)
                        results.append({
                            "title": title,
                            "body": body,
                            "url": url,
                            "source": source,
                            "date": date,
                        })
            except Exception as e:
                print(f"DEBUG: News fallback failed: {e}")

        if not results:
            return (
                "I couldn't find current news stories right now. "
                "The news search did not return usable article results."
            )

        context_parts = []
        for i, r in enumerate(results[:8], 1):
            body = re.sub(r"https?://\S+|www\.\S+", " ", r["body"])
            body = re.sub(r"\s+", " ", body).strip()
            if not body:
                continue
            metadata = " | ".join(
                x for x in (r["source"], r["date"]) if x
            )
            context_parts.append(
                f"Article {i}: {r['title']}\n"
                f"{metadata}\n"
                f"{body}"
            )

        if not context_parts:
            return (
                "The search returned article links but no usable story text."
            )

        context = "\n\n".join(context_parts)

        if news_query:
            summary_prompt = f"""You are J.A.R.V.I.S. summarizing fresh news for a voice user.
User request: {query}

Fresh article results:
{context}

Give the user the actual news stories, not a list of news websites.
Mention the 3 to 5 most important distinct developments, with the location/topic
and source name when useful. Do not invent facts. Do not repeat the same story.
If the evidence is weak or conflicting, say so briefly.
Keep the spoken answer under about 90 words.
Do not use Markdown, bullets, URLs, raw JSON, or source labels like "Article 1"."""
        else:
            summary_prompt = f"""You are J.A.R.V.I.S. answering a voice question using fresh web results.
Question: {query}

Fresh web results:
{context}

Answer directly using only information supported by these results.
Do not invent details. Keep it concise, natural, and useful.
Do not use Markdown, bullets, URLs, raw JSON, or source labels."""

        response = groq_client.chat.completions.create(
            model="openai/gpt-oss-120b",
            messages=[{"role": "user", "content": summary_prompt}],
            max_tokens=220,
            reasoning_effort="low",
        )
        return compact_spoken_reply(
            response.choices[0].message.content.strip()
        )

    except Exception as e:
        print(f"DEBUG: Web search failed: {e}")
        return "Sorry, I couldn't search the web right now."



def system_control(command_name):
    command_name = normalize_command_text(command_name)

    aliases = {
        "shut down": "shutdown",
        "shutdown": "shutdown",
        "turn off": "shutdown",
        "power off": "shutdown",
        "restart": "restart",
        "reboot": "restart",
        "lock": "lock",
        "lock screen": "lock",
        "sleep": "sleep",
    }

    cmd_key = aliases.get(command_name)
    if cmd_key is None:
        return "I don't recognize that laptop power command."

    if cmd_key in CONFIRM_REQUIRED:
        speak(
            f"Are you sure you want to {cmd_key}? "
            "Say yes to confirm."
        )
        confirmation = listen_for_question(timeout=6, max_seconds=6)
        if not confirmation:
            return "Okay, cancelled."

        confirmation_text = normalize_command_text(confirmation)
        if confirmation_text not in {"yes", "yes please", "confirm", "do it"}:
            return "Okay, cancelled."

    cmd = SYSTEM_COMMANDS[cmd_key]
    try:
        subprocess.Popen(
            cmd,
            shell=True,
            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
        )
        if cmd_key == "shutdown":
            return "Shutting down in 5 seconds."
        if cmd_key == "restart":
            return "Restarting in 5 seconds."
        if cmd_key == "lock":
            return "Locking your screen."
        return "Going to sleep."
    except Exception as e:
        print(f"DEBUG: System control failed: {e}")
        return f"Sorry, I couldn't {cmd_key} the system."


def volume_control_action(command_name):
    """Apply an exact volume command."""
    if volume_control is None:
        return "I can't control the Windows volume right now."

    command_name = normalize_command_text(command_name)
    aliases = {
        "volume up": "volume up",
        "increase volume": "volume up",
        "turn volume up": "volume up",
        "volume down": "volume down",
        "decrease volume": "volume down",
        "turn volume down": "volume down",
        "mute": "mute",
        "mute volume": "mute",
        "unmute": "unmute",
        "unmute volume": "unmute",
    }
    cmd = aliases.get(command_name)
    if cmd is None:
        return "I don't know that volume command."

    try:
        if cmd == "mute":
            volume_control.SetMute(1, None)
            return "Muted."

        if cmd == "unmute":
            volume_control.SetMute(0, None)
            return "Unmuted."

        current = volume_control.GetMasterVolumeLevelScalar()

        if cmd == "volume up":
            new_level = min(current + 0.1, 1.0)
        else:
            new_level = max(current - 0.1, 0.0)

        volume_control.SetMasterVolumeLevelScalar(new_level, None)
        actual = round(volume_control.GetMasterVolumeLevelScalar() * 100)
        return f"Volume is now {actual} percent."

    except Exception as e:
        print(f"DEBUG: Volume control failed: {e}")
        return "Sorry, I couldn't change the volume."

def set_volume_percent(percent):
    if volume_control is None:
        return "I can't control the Windows volume right now."

    percent = max(0, min(100, int(percent)))
    try:
        volume_control.SetMasterVolumeLevelScalar(percent / 100, None)
        actual = round(volume_control.GetMasterVolumeLevelScalar() * 100)
        return f"Volume set to {actual} percent."
    except Exception as e:
        print(f"DEBUG: Volume set failed: {e}")
        return "Sorry, I couldn't set the volume."


